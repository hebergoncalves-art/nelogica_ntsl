    if poiTotalVisual >= 19 then
    begin
      poiRotulo := "POI FLIP+";
      if poiLados[poiOrdem[19]] = -1 then
        poiRotulo := "POI FLIP-";
      if poiTipo[poiOrdem[19]] = 1 then
        poiRotulo := "Extreme POI"
      else if poiTipo[poiOrdem[19]] = 2 then
        poiRotulo := "Continuation POI";
      HorizontalLineCustom(poiCentroV[19], poiCores[19], 1, 0, poiRotulo, 8, 1,
        poiDiaIniV[19], poiDiaPrimeiroV[19], poiAlturaV[19], poiHoraIniV[19], poiHoraPrimeiroV[19]);
      if poiMeioDiasV[19] then
        HorizontalLineCustom(poiCentroV[19], poiCores[19], 1, 0, "", 8, 1,
          poiMeioIniV[19], poiMeioFimV[19], poiAlturaV[19]);
      if poiDiaIniV[19] <> poiDiaFimV[19] then
        HorizontalLineCustom(poiCentroV[19], poiCores[19], 1, 0, "", 8, 1,
          poiDiaFimV[19], poiDiaFimV[19], poiAlturaV[19], 0, poiHoraFimV[19]);
      if MeioZonaFlip then
        HorizontalLineCustom(poiCentroV[19], poiCores[19], 1, 1, "", 8, 1,
          poiDiaIniV[19], poiDiaFimV[19], 0, poiHoraIniV[19], poiHoraFimV[19]);
      if MostrarOrigemFlip then
        LineSegment(poiCentroV[19], poiCentroV[19], poiDiaOrigV[19], poiDiaIniV[19], False, "Origem POI",
          poiCores[19], 1, 1, 8, 1, poiHoraOrigV[19], poiHoraIniV[19]);
    end;

    if poiTotalVisual >= 20 then
    begin
      poiRotulo := "POI FLIP+";
      if poiLados[poiOrdem[20]] = -1 then
        poiRotulo := "POI FLIP-";
      if poiTipo[poiOrdem[20]] = 1 then
        poiRotulo := "Extreme POI"
      else if poiTipo[poiOrdem[20]] = 2 then
        poiRotulo := "Continuation POI";
      HorizontalLineCustom(poiCentroV[20], poiCores[20], 1, 0, poiRotulo, 8, 1,
        poiDiaIniV[20], poiDiaPrimeiroV[20], poiAlturaV[20], poiHoraIniV[20], poiHoraPrimeiroV[20]);
      if poiMeioDiasV[20] then
        HorizontalLineCustom(poiCentroV[20], poiCores[20], 1, 0, "", 8, 1,
          poiMeioIniV[20], poiMeioFimV[20], poiAlturaV[20]);
      if poiDiaIniV[20] <> poiDiaFimV[20] then
        HorizontalLineCustom(poiCentroV[20], poiCores[20], 1, 0, "", 8, 1,
          poiDiaFimV[20], poiDiaFimV[20], poiAlturaV[20], 0, poiHoraFimV[20]);
      if MeioZonaFlip then
        HorizontalLineCustom(poiCentroV[20], poiCores[20], 1, 1, "", 8, 1,
          poiDiaIniV[20], poiDiaFimV[20], 0, poiHoraIniV[20], poiHoraFimV[20]);
      if MostrarOrigemFlip then
        LineSegment(poiCentroV[20], poiCentroV[20], poiDiaOrigV[20], poiDiaIniV[20], False, "Origem POI",
          poiCores[20], 1, 1, 8, 1, poiHoraOrigV[20], poiHoraIniV[20]);
    end;
  end;

  if flipCalcula and MostrarFibFlip and flipAvancadoValido and (ModoFaixaOB = 0) and LastBarOnChart
    and (CurrentBar > 0) and (smcOrigemPublicada = CurrentBar - 1) then
    for flipQualLado := 1 to 4 do
    begin
      flipQualSlot := flipUltimaFib[flipQualLado];
      if flipQualSlot >= 0 then
      begin
        flipQualLo := flipEventoFibLo[flipQualSlot];
        flipQualHi := flipEventoFibHi[flipQualSlot];
        if flipQualHi > flipQualLo then
        begin
          flipQualRange := flipQualLo - flipQualHi;
          flipQualLo := flipQualHi;
          flipQualCor := CorFaixaFlipAlta;
          if Mod(flipQualLado, 2) = 0 then
          begin
            flipQualLo := flipEventoFibLo[flipQualSlot];
            flipQualRange := -flipQualRange;
            flipQualCor := CorFaixaFlipBaixa;
          end;
          flipQualPreco50 := flipQualLo + flipQualRange / 2;
          flipQualPrecoPrefer := flipQualLo + flipQualRange * FibPreferencialFlip / 100;
          flipQualPrecoExtremo := flipQualLo + flipQualRange * FibExtremoFlip / 100;
          if flipQualLado = 1 then
          begin
            LineSegment(flipQualPreco50, flipQualPreco50, flipEventoQualDia[flipQualSlot], smcDataConfirmada, False, "Fib 50%",
              flipQualCor, 1, 1, 8, 1, flipEventoQualHora[flipQualSlot], smcHoraConfirmada);
            LineSegment(flipQualPrecoPrefer, flipQualPrecoPrefer, flipEventoQualDia[flipQualSlot], smcDataConfirmada, False, "Fib preferencial",
              flipQualCor, 1, 1, 8, 1, flipEventoQualHora[flipQualSlot], smcHoraConfirmada);
            LineSegment(flipQualPrecoExtremo, flipQualPrecoExtremo, flipEventoQualDia[flipQualSlot], smcDataConfirmada, False, "Fib extremo",
              flipQualCor, 1, 1, 8, 1, flipEventoQualHora[flipQualSlot], smcHoraConfirmada);
          end
          else if flipQualLado = 2 then
          begin
            LineSegment(flipQualPreco50, flipQualPreco50, flipEventoQualDia[flipQualSlot], smcDataConfirmada, False, "Fib 50%",
              flipQualCor, 1, 1, 8, 1, flipEventoQualHora[flipQualSlot], smcHoraConfirmada);
            LineSegment(flipQualPrecoPrefer, flipQualPrecoPrefer, flipEventoQualDia[flipQualSlot], smcDataConfirmada, False, "Fib preferencial",
              flipQualCor, 1, 1, 8, 1, flipEventoQualHora[flipQualSlot], smcHoraConfirmada);
            LineSegment(flipQualPrecoExtremo, flipQualPrecoExtremo, flipEventoQualDia[flipQualSlot], smcDataConfirmada, False, "Fib extremo",
              flipQualCor, 1, 1, 8, 1, flipEventoQualHora[flipQualSlot], smcHoraConfirmada);
          end
          else if flipQualLado = 3 then
          begin
            LineSegment(flipQualPreco50, flipQualPreco50, flipEventoQualDia[flipQualSlot], smcDataConfirmada, False, "Fib 50%",
              flipQualCor, 1, 1, 8, 1, flipEventoQualHora[flipQualSlot], smcHoraConfirmada);
            LineSegment(flipQualPrecoPrefer, flipQualPrecoPrefer, flipEventoQualDia[flipQualSlot], smcDataConfirmada, False, "Fib preferencial",
              flipQualCor, 1, 1, 8, 1, flipEventoQualHora[flipQualSlot], smcHoraConfirmada);
            LineSegment(flipQualPrecoExtremo, flipQualPrecoExtremo, flipEventoQualDia[flipQualSlot], smcDataConfirmada, False, "Fib extremo",
              flipQualCor, 1, 1, 8, 1, flipEventoQualHora[flipQualSlot], smcHoraConfirmada);
          end
          else if flipQualLado = 4 then
          begin
            LineSegment(flipQualPreco50, flipQualPreco50, flipEventoQualDia[flipQualSlot], smcDataConfirmada, False, "Fib 50%",
              flipQualCor, 1, 1, 8, 1, flipEventoQualHora[flipQualSlot], smcHoraConfirmada);
            LineSegment(flipQualPrecoPrefer, flipQualPrecoPrefer, flipEventoQualDia[flipQualSlot], smcDataConfirmada, False, "Fib preferencial",
              flipQualCor, 1, 1, 8, 1, flipEventoQualHora[flipQualSlot], smcHoraConfirmada);
            LineSegment(flipQualPrecoExtremo, flipQualPrecoExtremo, flipEventoQualDia[flipQualSlot], smcDataConfirmada, False, "Fib extremo",
              flipQualCor, 1, 1, 8, 1, flipEventoQualHora[flipQualSlot], smcHoraConfirmada);
          end;
        end;
      end;
    end;

  // Separar os segmentos confirmados das guias provisórias. Os valores de B
  // e dos pivos sao imutaveis, inclusive quando a barra de publicacao recalcula.
  if flipCalcula and (ModoFaixaOB = 0) and (MostrarFlip or MostrarCandidatosFlip)
    and (CurrentBar > 0) and (smcOrigemPublicada = CurrentBar - 1) then
    for flipLado := 1 to 4 do
    begin
      flipDesenha := False;
      flipDestino := flipQualPublicado[flipLado];
      flipCor := RGB(0, 128, 0);
      if Mod(flipLado, 2) = 0 then
        flipCor := RGB(255, 0, 0);
      if MostrarFlip and (flipDestino >= 0) then
      begin
        flipDesenha := flipEventoQualPublicacao[flipDestino] = CurrentBar;
        flipNivelDesenho := flipEventoNivel[flipDestino];
        flipInicioDia := flipEventoDataMeio[flipDestino];
        flipInicioHora := flipEventoHoraMeio[flipDestino];
        flipFimDia := flipEventoQualDia[flipDestino];
        flipFimHora := flipEventoQualHora[flipDestino];
        flipTraco := 0;
        flipLegenda := "FLIP+ I";
        if flipLado = 2 then
          flipLegenda := "FLIP− I"
        else if flipLado = 3 then
          flipLegenda := "FLIP+ S"
        else if flipLado = 4 then
          flipLegenda := "FLIP− S";
      end
      else if MostrarCandidatosFlip and LastBarOnChart and (flipFase[flipLado] = FlipArmado) then
      begin
        flipDesenha := True;
        flipNivelDesenho := flipMeioPreco[flipLado];
        flipInicioDia := flipMeioDia[flipLado];
        flipInicioHora := flipMeioHora[flipLado];
        flipFimDia := smcDataConfirmada;
        flipFimHora := smcHoraConfirmada;
        flipTraco := 1;
        flipLegenda := "Candidato + I";
        if flipLado = 2 then
          flipLegenda := "Candidato − I"
        else if flipLado = 3 then
          flipLegenda := "Candidato + S"
        else if flipLado = 4 then
          flipLegenda := "Candidato − S";
      end;

      if flipDesenha then
      begin
        if flipLado = 1 then
          LineSegment(flipNivelDesenho, flipNivelDesenho, flipInicioDia, flipFimDia, False, flipLegenda,
            flipCor, 1, flipTraco, 8, 1, flipInicioHora, flipFimHora)
        else if flipLado = 2 then
          LineSegment(flipNivelDesenho, flipNivelDesenho, flipInicioDia, flipFimDia, False, flipLegenda,
            flipCor, 1, flipTraco, 8, 1, flipInicioHora, flipFimHora)
        else if flipLado = 3 then
          LineSegment(flipNivelDesenho, flipNivelDesenho, flipInicioDia, flipFimDia, False, flipLegenda,
            flipCor, 1, flipTraco, 8, 1, flipInicioHora, flipFimHora)
        else
          LineSegment(flipNivelDesenho, flipNivelDesenho, flipInicioDia, flipFimDia, False, flipLegenda,
            flipCor, 1, flipTraco, 8, 1, flipInicioHora, flipFimHora);
      end;
    end;
end;
