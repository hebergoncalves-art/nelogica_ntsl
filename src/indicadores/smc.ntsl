  idmUsados, idmMotivo, idmBosMotivo, idmVinculosTotal, idmVinculosProximo : array[1..2] of Integer;
  idmHistATR : array[0..SMCHistUltimoInterno] of Float;
  idmHistATRValido : array[0..SMCHistUltimoInterno] of Boolean;
  idmID, idmEstado, idmOrigem, idmPivo, idmNivelTicks : array[0..IDMUltimoIndice] of Integer;
  idmProtecaoOrigem, idmProtecaoRef, idmNivelProtegidoTicks, idmBosRef, idmAlvoRef : array[0..IDMUltimoIndice] of Integer;
  idmAtivacao, idmPublicacao, idmData, idmHora, idmFim, idmDiaFim, idmHoraFim : array[0..IDMUltimoIndice] of Integer;
  idmVinculoID, idmVinculoPivo, idmVinculoBos, idmVinculoQualificacao : array[0..IDMUltimoIndice] of Integer;
  idmATR, idmNivel : array[0..IDMUltimoIndice] of Float;
  idmATRValido : array[0..IDMUltimoIndice] of Boolean;
  idmVisual : array[1..IDMLimiteVisual] of Integer;

begin
  // Gravar data e hora em series antes de consultar candles anteriores.
  dataCandle := Date;
  horaCandle := Time;

  calculaBlocosSwing := ((ModoFaixaOB = 0) and MostrarBlocosSwing)
    or (ModoFaixaOB = 1) or (ModoFaixaOB = 2);
  calculaBlocosInternos := ((ModoFaixaOB = 0) and MostrarBlocosInternos)
    or (ModoFaixaOB = 3) or (ModoFaixaOB = 4);
  calculaEQ := (ModoFaixaOB = 0) and MostrarEQHEQL;
  exibeFVG := (ModoFaixaOB = 0) and MostrarFVG;
  calculaBreaker := MostrarBreakerBlocks and ((ModoFaixaOB = 1) or (ModoFaixaOB = 2));
  observaEQ := calculaEQ or DebugSMC;
  calculaPD := ((ModoFaixaOB = 0) and MostrarZonasPD) or DebugSMC;
  calculaOBInterno := calculaBlocosInternos or DebugSMC;
  calculaOBSwing := calculaBlocosSwing or DebugSMC;
  flipConfigValida := (EscalaFlip >= 0) and (EscalaFlip <= 2)
    and (ReacaoMinFlipATR >= 0) and (MaxBarrasFlip >= 0);
  flipCalcula := HabilitarFlip and flipConfigValida;
  flipAvancadoValido := (ModoFalhaFlip >= 0) and (ModoFalhaFlip <= 2)
    and (FiltroDispFlip >= 0) and (FiltroDispFlip <= 2) and (FiltroFVGFlip >= 0) and (FiltroFVGFlip <= 2)
    and (FiltroVolumeFlip >= 0) and (FiltroVolumeFlip <= 2) and (DispATRFlip >= 0)
    and (CorpoMinFlip >= 0) and (CorpoMinFlip <= 1) and (MaxCandlesDispFlip >= 1) and (MaxCandlesDispFlip <= 3)
    and (MaxBarrasFVGFlip >= 0) and (FatorVolumeFlip >= 0) and (PeriodoVolumeFlip >= 1)
    and (FiltroFibFlip >= 0) and (FiltroFibFlip <= 4)
    and (FibPreferencialFlip >= 50) and (FibExtremoFlip >= FibPreferencialFlip) and (FibExtremoFlip <= 100)
    and (FibCustomMin >= 0) and (FibCustomMax >= FibCustomMin) and (FibCustomMax <= 100)
    and (ModoLocalizacaoFlip >= 0) and (ModoLocalizacaoFlip <= 2) and (ModoRangeFlip >= 0) and (ModoRangeFlip <= 1);
  flipTemFiltro := (FiltroDispFlip > 0) or (FiltroFVGFlip > 0) or (FiltroVolumeFlip > 0);
  flipUsaFib := (FiltroFibFlip > 0) or MostrarFibFlip;
  calculaFVG := exibeFVG or DebugSMC;
  flipDetectaFVG := flipCalcula and flipAvancadoValido and (FiltroFVGFlip > 0);
  poiConfigValida := (TipoZonaFlip >= 0) and (TipoZonaFlip <= 2)
    and (MaxBuscaOrigemFlip >= 1) and (MaxBaseCandlesFlip >= 1) and (BaseRangeFlipATR >= 0)
    and (MaxLarguraFlipATR >= 0) and (MaxFlipVisiveis >= 1) and (MaxFlipVisiveis <= POILimiteVisual)
    and (ModoInvalidacaoFlip >= 0) and (ModoInvalidacaoFlip <= 1) and (BufferInvalidacaoTicksFlip >= 0)
    and (MostrarInvalidadasFlip >= 0) and (MostrarInvalidadasFlip <= 2)
    and ((OcultarMitigadasFlip = 0) or (OcultarMitigadasFlip = 50) or (OcultarMitigadasFlip = 100))
    and ((EncerrarAposMitigacaoFlip = 0) or (EncerrarAposMitigacaoFlip = 50) or (EncerrarAposMitigacaoFlip = 100))
    and (MaxIdadeFlip >= 0) and (MaxVisitasFlip >= 0) and (ModoRetesteFlip >= 0) and (ModoRetesteFlip <= 2)
    and (ReacaoRetesteATRFlip >= 0) and (MaxBarrasRetesteFlip >= 1);
  poiCalcula := flipCalcula and poiConfigValida;
  idmConfigValida := (ModoIDM = 0) and (MinPullbackIDMATR >= 0) and (MinReacaoIDMATR >= 0)
    and (MinDistProtegidoTicks >= 0) and (MaxBuscaPullback >= 1)
    and ((PoliticaNovoBOS = 0) or (PoliticaNovoBOS = 1));
  idmCalcula := HabilitarIDM and idmConfigValida;
  smcCalcula := DebugSMC or flipCalcula or idmCalcula;

  smcColeta := False;
  if smcCalcula then
  begin
    smcConfigValida := (PeriodoATRSMC >= 2) and (ToleranciaSMCTicks >= 0)
      and (BufferRupturaSMCTicks >= 0);
    if CurrentBar = 0 then
    begin
      smcUltimaPublicacao := -1;
      smcOrigemPublicada := -1;
      smcPublicados := 0;
      smcReciclados := 0;
      smcRejeitadosCapacidade := 0;
      smcMaiorLote := 0;
      smcLoteAusente := False;
      smcCarimbos[0] := 0;
      smcCarimbos[1] := 0;
      smcAmostrasATR := 0;
      smcBarrasValidas := 0;
      smcSomaTR := 0;
      smcATR := 0;
      smcATRDisponivel := False;
      smcTemAnterior := False;
      if idmCalcula then
      begin
        idmIDTotal := 0;
        for idmLado := 1 to 2 do
        begin
          idmUsados[idmLado] := 0;
          idmVinculosTotal[idmLado] := 0;
          idmVinculosProximo[idmLado] := 0;
          idmMotivo[idmLado] := 0;
          idmBosMotivo[idmLado] := -1;
        end;
      end;
      for smcFaixa := 1 to 19 do
        smcUsados[smcFaixa] := 0;
      for smcLado := 1 to 4 do
      begin
        smcEspera[smcLado] := -1;
        smcPivoConfirmado[smcLado] := -1;
        smcPivoValido[smcLado] := False;
      end;
      for smcEscala := 0 to 1 do
      begin
        smcFluxo[smcEscala] := 0;
        smcContexto[smcEscala] := 0;
        smcProtecaoConfirmacao[smcEscala] := -1;
        smcHistInicio[smcEscala] := 0;
        smcHistTotal[smcEscala] := 0;
      end;
      if flipCalcula then
      begin
        flipTotal := 0;
        flipSemVagaTotal := 0;
        for flipLado := 1 to 4 do
        begin
          flipFase[flipLado] := 0;
          flipUsados[flipLado] := 0;
          flipMotivo[flipLado] := 0;
          flipBarraMotivo[flipLado] := -1;
          flipPublicadoSlot[flipLado] := -1;
          flipQualPublicado[flipLado] := -1;
          flipQualPendenteSlot[flipLado] := -1;
          flipUltimaFib[flipLado] := -1;
        end;
        poiIdTotal := 0;
        for poiLado := 1 to 12 do
          poiUsados[poiLado] := 0;
        for flipQualIndice := 1 to 2 do
          flipQualFVGBarra[flipQualIndice] := -1;
      end;
    end;
    // Uma nova passagem pela barra em formacao substitui o lote inteiro.
    smcColeta := CurrentBar > smcUltimaPublicacao;
    if smcColeta then
    begin
      smcQuadro := Mod(CurrentBar, 2);
      smcBase := smcQuadro * SMCLote;
      smcContador := 0;
      smcOrigemEQTopo := -1;
      smcOrigemEQFundo := -1;
      smcOrigemPD := -1;
      if CurrentBar > 0 then
      begin
        smcOrigemEQTopo := smcOrigemEQTopo[1];
        smcOrigemEQFundo := smcOrigemEQFundo[1];
        smcOrigemPD := smcOrigemPD[1];
      end;
    end;
  end;
  if calculaBreaker then
  begin
    ladoOrigemBreaker := 1;
    if ModoFaixaOB = 2 then
      ladoOrigemBreaker := -1;

    if CurrentBar = 0 then
    begin
      for leituraBreaker := 0 to QuadrosOBRemovidos - 1 do
        carimbosOBRemovidos[leituraBreaker] := 0;
      for leituraBreaker := 0 to 2 do
        carimbosBreaker[leituraBreaker] := 0;
    end;
    quadroOBRemovido := Mod(CurrentBar, QuadrosOBRemovidos);
    quantidadesOBRemovidos[quadroOBRemovido] := 0;
    carimbosOBRemovidos[quadroOBRemovido] := CurrentBar + 1;
  end;
  faixaSelecionada := False;
  criacaoFaixa := 0;

  periodo := PeriodoSwing;
  if periodo < 10 then
    periodo := 10;

  // Partir da barra anterior tambem durante reavaliacoes intrabar.
  if CurrentBar = 0 then
  begin
    perna := 0;
    vies := 0;
    nivelTopo := 0;
    nivelFundo := 0;
    temTopo := False;
    temFundo := False;
    topoRompido := False;
    fundoRompido := False;
    pernaInterna := 0;
    viesInterno := 0;
    topoInterno := 0;
    fundoInterno := 0;
    temTopoInterno := False;
    temFundoInterno := False;
    topoInternoRompido := False;
    fundoInternoRompido := False;
    barraTopo := 0;
    barraFundo := 0;
    barraTopoInterno := 0;
    barraFundoInterno := 0;
  end
  else
  begin
    perna := perna[1];
    vies := vies[1];
    nivelTopo := nivelTopo[1];
    nivelFundo := nivelFundo[1];
    temTopo := temTopo[1];
    temFundo := temFundo[1];
    topoRompido := topoRompido[1];
    fundoRompido := fundoRompido[1];
    pernaInterna := pernaInterna[1];
    viesInterno := viesInterno[1];
    topoInterno := topoInterno[1];
    fundoInterno := fundoInterno[1];
    temTopoInterno := temTopoInterno[1];
    temFundoInterno := temFundoInterno[1];
    topoInternoRompido := topoInternoRompido[1];
    fundoInternoRompido := fundoInternoRompido[1];
    barraTopo := barraTopo[1];
    barraFundo := barraFundo[1];
    barraTopoInterno := barraTopoInterno[1];
    barraFundoInterno := barraFundoInterno[1];
  end;

  rompeTopo := False;
  rompeFundo := False;
  rompeTopoInterno := False;
  rompeFundoInterno := False;

  if CurrentBar >= periodo then
  begin
    if High[periodo] > Highest(High, periodo) then
      perna := 0
    else if Low[periodo] < Lowest(Low, periodo) then
      perna := 1;

    if perna <> perna[1] then
    begin
      if perna = 1 then
      begin
        nivelFundo := Low[periodo];
        barraFundo := CurrentBar - periodo;
        temFundo := True;
        fundoRompido := False;
        if smcColeta then
        begin
          smcSlot := smcBase + smcContador;
          smcEventoFaixa[smcSlot] := 4;
          smcEventoOrigem[smcSlot] := barraFundo;
          smcEventoRef[smcSlot] := -1;
          smcEventoNascimento[smcSlot] := CurrentBar;
          smcEventoEstado[smcSlot] := SMCFato;
          smcEventoLo[smcSlot] := nivelFundo;
          smcEventoHi[smcSlot] := nivelFundo;
          smcEventoBrutoLo[smcSlot] := nivelFundo;
          smcEventoBrutoHi[smcSlot] := nivelFundo;
          smcContador := smcContador + 1;
        end;
        if (ModoFaixaOB = 0) and MostrarPivos then
          PlotText("Fundo swing", clLime, 0, 10);
      end
      else
      begin
        nivelTopo := High[periodo];
        barraTopo := CurrentBar - periodo;
        temTopo := True;
        topoRompido := False;
        if smcColeta then
        begin
          smcSlot := smcBase + smcContador;
          smcEventoFaixa[smcSlot] := 3;
          smcEventoOrigem[smcSlot] := barraTopo;
          smcEventoRef[smcSlot] := -1;
          smcEventoNascimento[smcSlot] := CurrentBar;
          smcEventoEstado[smcSlot] := SMCFato;
          smcEventoLo[smcSlot] := nivelTopo;
          smcEventoHi[smcSlot] := nivelTopo;
          smcEventoBrutoLo[smcSlot] := nivelTopo;
          smcEventoBrutoHi[smcSlot] := nivelTopo;
          smcContador := smcContador + 1;
        end;
        if (ModoFaixaOB = 0) and MostrarPivos then
          PlotText("Topo swing", clRed, 2, 10);
      end;
    end;

    // A comparacao anterior usa o nivel anterior da serie, como no Pine.
    rompeTopo := temTopo and temTopo[1] and (not topoRompido)
      and (Close > nivelTopo) and (Close[1] <= nivelTopo[1]);
    rompeFundo := temFundo and temFundo[1] and (not fundoRompido)
      and (Close < nivelFundo) and (Close[1] >= nivelFundo[1]);
  end;

  if calculaPD then
  begin
    topoPD := 0;
    fundoPD := 0;
    diaOrigemPD := 0;
    horaOrigemPD := 0;

    if CurrentBar > 0 then
    begin
      diaOrigemPD := diaOrigemPD[1];
      horaOrigemPD := horaOrigemPD[1];
      if temTopo[1] then
        topoPD := Max(topoPD[1], High);
      if temFundo[1] then
        fundoPD := Min(fundoPD[1], Low);

      if smcColeta and temTopo[1] and temFundo[1] and (topoPD > fundoPD) then
      begin
        smcSlot := smcBase + smcContador;
        smcEventoFaixa[smcSlot] := 17;
        smcEventoOrigem[smcSlot] := smcOrigemPD;
        smcEventoRef[smcSlot] := -1;
        smcEventoNascimento[smcSlot] := CurrentBar;
        smcEventoEstado[smcSlot] := SMCFato;
        smcEventoLo[smcSlot] := fundoPD;
        smcEventoHi[smcSlot] := topoPD;
        smcEventoBrutoLo[smcSlot] := fundoPD;
        smcEventoBrutoHi[smcSlot] := topoPD;
        smcContador := smcContador + 1;
      end;

      if (ModoFaixaOB = 0) and MostrarZonasPD and LastBarOnChart
        and temTopo[1] and temFundo[1] and (topoPD > fundoPD) then
      begin
        amplitudePD := topoPD - fundoPD;
        meiaAlturaPD := amplitudePD * 0.025;
        centroPremiumPD := topoPD - meiaAlturaPD;
        centroEquilibriumPD := fundoPD + amplitudePD / 2;
        centroDiscountPD := fundoPD + meiaAlturaPD;

        fimPrimeiroDiaPD := dataCandle;
        horaFimPrimeiroDiaPD := horaCandle;
        if diaOrigemPD <> dataCandle then
        begin
          fimPrimeiroDiaPD := diaOrigemPD;
          horaFimPrimeiroDiaPD := 2359;
        end;

        HorizontalLineCustom(centroPremiumPD, CorZonaPremium, 1, 0, "Premium", 8, 1,
          diaOrigemPD, fimPrimeiroDiaPD, meiaAlturaPD, horaOrigemPD, horaFimPrimeiroDiaPD);
        HorizontalLineCustom(centroEquilibriumPD, CorZonaEquilibrium, 1, 0, "Equilibrium", 8, 1,
          diaOrigemPD, fimPrimeiroDiaPD, meiaAlturaPD, horaOrigemPD, horaFimPrimeiroDiaPD);
        HorizontalLineCustom(centroDiscountPD, CorZonaDiscount, 1, 0, "Discount", 8, 1,
          diaOrigemPD, fimPrimeiroDiaPD, meiaAlturaPD, horaOrigemPD, horaFimPrimeiroDiaPD);

        if diaOrigemPD <> dataCandle then
        begin
          primeiroDiaIntermediarioPD := CalcDate(diaOrigemPD, 1);
          ultimoDiaIntermediarioPD := CalcDate(dataCandle, -1);
          if primeiroDiaIntermediarioPD <= ultimoDiaIntermediarioPD then
          begin
            HorizontalLineCustom(centroPremiumPD, CorZonaPremium, 1, 0, "", 8, 1,
              primeiroDiaIntermediarioPD, ultimoDiaIntermediarioPD, meiaAlturaPD);
            HorizontalLineCustom(centroEquilibriumPD, CorZonaEquilibrium, 1, 0, "", 8, 1,
              primeiroDiaIntermediarioPD, ultimoDiaIntermediarioPD, meiaAlturaPD);
            HorizontalLineCustom(centroDiscountPD, CorZonaDiscount, 1, 0, "", 8, 1,
              primeiroDiaIntermediarioPD, ultimoDiaIntermediarioPD, meiaAlturaPD);
          end;

          HorizontalLineCustom(centroPremiumPD, CorZonaPremium, 1, 0, "", 8, 1,
            dataCandle, dataCandle, meiaAlturaPD, 0, horaCandle);
          HorizontalLineCustom(centroEquilibriumPD, CorZonaEquilibrium, 1, 0, "", 8, 1,
            dataCandle, dataCandle, meiaAlturaPD, 0, horaCandle);
          HorizontalLineCustom(centroDiscountPD, CorZonaDiscount, 1, 0, "", 8, 1,
            dataCandle, dataCandle, meiaAlturaPD, 0, horaCandle);
        end;
      end;

      // O Pine desenha antes de aplicar os pivos confirmados nesta barra.
      if (CurrentBar >= periodo) and (perna <> perna[1]) then
      begin
        if perna = 1 then
          fundoPD := nivelFundo
        else
          topoPD := nivelTopo;
        diaOrigemPD := dataCandle[periodo];
        horaOrigemPD := horaCandle[periodo];
        if smcColeta then
          smcOrigemPD := CurrentBar - periodo;
      end;
    end;
  end;

  if (MostrarEstruturaInterna or calculaOBInterno or idmCalcula or (flipCalcula and (EscalaFlip <> 1))
    or (poiCalcula and (ModoRetesteFlip = 2)))
    and (CurrentBar >= JanelaInterna) then
  begin
    if High[JanelaInterna] > Highest(High, JanelaInterna) then
      pernaInterna := 0
    else if Low[JanelaInterna] < Lowest(Low, JanelaInterna) then
      pernaInterna := 1;

    if pernaInterna <> pernaInterna[1] then
    begin
      if pernaInterna = 1 then
      begin
        fundoInterno := Low[JanelaInterna];
        barraFundoInterno := CurrentBar - JanelaInterna;
        temFundoInterno := True;
        fundoInternoRompido := False;
        if smcColeta then
        begin
          smcSlot := smcBase + smcContador;
          smcEventoFaixa[smcSlot] := 2;
          smcEventoOrigem[smcSlot] := barraFundoInterno;
          smcEventoRef[smcSlot] := -1;
          smcEventoNascimento[smcSlot] := CurrentBar;
          smcEventoEstado[smcSlot] := SMCFato;
          smcEventoLo[smcSlot] := fundoInterno;
          smcEventoHi[smcSlot] := fundoInterno;
          smcEventoBrutoLo[smcSlot] := fundoInterno;
          smcEventoBrutoHi[smcSlot] := fundoInterno;
          smcContador := smcContador + 1;
        end;
      end
      else
      begin
        topoInterno := High[JanelaInterna];
        barraTopoInterno := CurrentBar - JanelaInterna;
        temTopoInterno := True;
        topoInternoRompido := False;
        if smcColeta then
        begin
          smcSlot := smcBase + smcContador;
          smcEventoFaixa[smcSlot] := 1;
          smcEventoOrigem[smcSlot] := barraTopoInterno;
          smcEventoRef[smcSlot] := -1;
          smcEventoNascimento[smcSlot] := CurrentBar;
          smcEventoEstado[smcSlot] := SMCFato;
          smcEventoLo[smcSlot] := topoInterno;
          smcEventoHi[smcSlot] := topoInterno;
          smcEventoBrutoLo[smcSlot] := topoInterno;
          smcEventoBrutoHi[smcSlot] := topoInterno;
          smcContador := smcContador + 1;
        end;
      end;
    end;

    // A posicao dos parenteses segue a expressao do Pine fornecido.
    pavioSuperior := High - Max(Close, Open);
    medidaInferior := Min(Close, Open - Low);

    rompeTopoInterno := temTopoInterno and temTopoInterno[1] and (not topoInternoRompido)
      and temTopo and (topoInterno <> nivelTopo)
      and (Close > topoInterno) and (Close[1] <= topoInterno[1])
      and ((not FiltroConfluenciaInterna) or (pavioSuperior > medidaInferior));
    if rompeTopoInterno then
    begin
      if (ModoFaixaOB = 0) and MostrarEstruturaInterna then
      begin
        if viesInterno = -1 then
          PlotText("CHoCH interno alta", clLime, 3, 8, topoInterno)
        else
          PlotText("BOS interno alta", clLime, 3, 8, topoInterno);
      end;
      if smcColeta then
      begin
        smcSlot := smcBase + smcContador;
        smcEventoFaixa[smcSlot] := 5;
        smcEventoOrigem[smcSlot] := barraTopoInterno;
        smcEventoRef[smcSlot] := -1;
        smcEventoNascimento[smcSlot] := CurrentBar;
        smcEventoEstado[smcSlot] := SMCFato;
        smcEventoLo[smcSlot] := topoInterno;
        smcEventoHi[smcSlot] := topoInterno;
        smcEventoBrutoLo[smcSlot] := viesInterno;
        smcEventoBrutoHi[smcSlot] := 1;
        smcContador := smcContador + 1;
      end;
      topoInternoRompido := True;
      viesInterno := 1;
    end;

    rompeFundoInterno := temFundoInterno and temFundoInterno[1] and (not fundoInternoRompido)
      and temFundo and (fundoInterno <> nivelFundo)
      and (Close < fundoInterno) and (Close[1] >= fundoInterno[1])
      and ((not FiltroConfluenciaInterna) or (pavioSuperior < medidaInferior));
    if rompeFundoInterno then
    begin
      if (ModoFaixaOB = 0) and MostrarEstruturaInterna then
      begin
        if viesInterno = 1 then
          PlotText("CHoCH interno baixa", clRed, 3, 8, fundoInterno)
        else
          PlotText("BOS interno baixa", clRed, 3, 8, fundoInterno);
      end;
      if smcColeta then
      begin
        smcSlot := smcBase + smcContador;
        smcEventoFaixa[smcSlot] := 6;
        smcEventoOrigem[smcSlot] := barraFundoInterno;
        smcEventoRef[smcSlot] := -1;
        smcEventoNascimento[smcSlot] := CurrentBar;
        smcEventoEstado[smcSlot] := SMCFato;
        smcEventoLo[smcSlot] := fundoInterno;
        smcEventoHi[smcSlot] := fundoInterno;
        smcEventoBrutoLo[smcSlot] := viesInterno;
        smcEventoBrutoHi[smcSlot] := -1;
        smcContador := smcContador + 1;
      end;
      fundoInternoRompido := True;
      viesInterno := -1;
    end;
  end;

  if rompeTopo then
  begin
    if ModoFaixaOB = 0 then
    begin
      Plot(nivelTopo);
      SetPlotColor(1, clGreen);
      if vies = -1 then
        PlotText("CHoCH alta", clGreen, 3, 8, nivelTopo)
      else
        PlotText("BOS alta", clGreen, 3, 8, nivelTopo);
    end;
    if smcColeta then
    begin
      smcSlot := smcBase + smcContador;
      smcEventoFaixa[smcSlot] := 7;
      smcEventoOrigem[smcSlot] := barraTopo;
      smcEventoRef[smcSlot] := -1;
      smcEventoNascimento[smcSlot] := CurrentBar;
      smcEventoEstado[smcSlot] := SMCFato;
      smcEventoLo[smcSlot] := nivelTopo;
      smcEventoHi[smcSlot] := nivelTopo;
      smcEventoBrutoLo[smcSlot] := vies;
      smcEventoBrutoHi[smcSlot] := 1;
      smcContador := smcContador + 1;
    end;
    topoRompido := True;
    vies := 1;
  end
  else if ModoFaixaOB = 0 then
    NoPlot(1);

  if rompeFundo then
  begin
    if ModoFaixaOB = 0 then
    begin
      Plot2(nivelFundo);
      SetPlotColor(2, clRed);
      if vies = 1 then
        PlotText("CHoCH baixa", clRed, 3, 8, nivelFundo)
      else
        PlotText("BOS baixa", clRed, 3, 8, nivelFundo);
    end;
    if smcColeta then
    begin
      smcSlot := smcBase + smcContador;
      smcEventoFaixa[smcSlot] := 8;
      smcEventoOrigem[smcSlot] := barraFundo;
      smcEventoRef[smcSlot] := -1;
      smcEventoNascimento[smcSlot] := CurrentBar;
      smcEventoEstado[smcSlot] := SMCFato;
      smcEventoLo[smcSlot] := nivelFundo;
      smcEventoHi[smcSlot] := nivelFundo;
      smcEventoBrutoLo[smcSlot] := vies;
      smcEventoBrutoHi[smcSlot] := -1;
      smcContador := smcContador + 1;
    end;
    fundoRompido := True;
    vies := -1;
  end
  else if ModoFaixaOB = 0 then
    NoPlot(2);

  // Exibir o ultimo nivel confirmado de cada lado, inclusive apos o rompimento.
  if (ModoFaixaOB = 0) and MostrarPivos and temTopo then
  begin
    Plot3(nivelTopo);
    SetPlotColor(3, clRed);
    SetPlotWidth(3, 2);
  end
  else if ModoFaixaOB = 0 then
    NoPlot(3);

  if (ModoFaixaOB = 0) and MostrarPivos and temFundo then
  begin
    Plot4(nivelFundo);
    SetPlotColor(4, clLime);
    SetPlotWidth(4, 2);
  end
  else if ModoFaixaOB = 0 then
    NoPlot(4);

  if calculaOBInterno or calculaOBSwing or observaEQ then
  begin
    trAtual := High - Low;
    somaTR := 0;
    if CurrentBar > 0 then
    begin
      trAtual := Max(trAtual, Max(Abs(High - Close[1]), Abs(Low - Close[1])));
      somaTR := somaTR[1] + trAtual;
    end;

    // ATR de Wilder com semente SMA. A media cumulativa ignora o TR da barra inicial.
    atrWilder := 0;
    if CurrentBar = 199 then
      atrWilder := (somaTR + trAtual[199]) / 200
    else if CurrentBar > 199 then
      atrWilder := (199 * atrWilder[1] + trAtual) / 200;
  end;

  if observaEQ then
  begin
    janelaEQ := BarrasConfirmacaoEQ;
    if janelaEQ < 1 then
      janelaEQ := 1;
    toleranciaEQ := Max(0, Min(LimiarEQ, 0.5)) * atrWilder;

    if CurrentBar = 0 then
    begin
      pernaEQ := 0;
      temTopoEQ := False;
      temFundoEQ := False;
      topoEQ := 0;
      fundoEQ := 0;
    end
    else
    begin
      pernaEQ := pernaEQ[1];
      temTopoEQ := temTopoEQ[1];
      temFundoEQ := temFundoEQ[1];
      topoEQ := topoEQ[1];
      fundoEQ := fundoEQ[1];
    end;

    if CurrentBar >= janelaEQ then
    begin
      if High[janelaEQ] > Highest(High, janelaEQ) then
        pernaEQ := 0
      else if Low[janelaEQ] < Lowest(Low, janelaEQ) then
        pernaEQ := 1;

      if pernaEQ <> pernaEQ[1] then
      begin
        if pernaEQ = 1 then
        begin
          if temFundoEQ and (Abs(Low[janelaEQ] - fundoEQ) < toleranciaEQ) then
          begin
            if calculaEQ then
              PlotText("EQL", clLime, 3, 8, Low[janelaEQ]);
            if smcColeta then
            begin
              smcSlot := smcBase + smcContador;
              smcEventoFaixa[smcSlot] := 16;
              smcEventoOrigem[smcSlot] := CurrentBar - janelaEQ;
              smcEventoRef[smcSlot] := smcOrigemEQFundo;
              smcEventoNascimento[smcSlot] := CurrentBar;
              smcEventoEstado[smcSlot] := SMCFato;
              smcEventoLo[smcSlot] := fundoEQ;
              smcEventoHi[smcSlot] := Low[janelaEQ];
              smcEventoBrutoLo[smcSlot] := fundoEQ;
              smcEventoBrutoHi[smcSlot] := Low[janelaEQ];
              smcContador := smcContador + 1;
            end;
          end;
          if smcColeta then
            smcOrigemEQFundo := CurrentBar - janelaEQ;
          fundoEQ := Low[janelaEQ];
          temFundoEQ := True;
        end
        else
        begin
          if temTopoEQ and (Abs(High[janelaEQ] - topoEQ) < toleranciaEQ) then
          begin
            if calculaEQ then
              PlotText("EQH", clRed, 3, 8, High[janelaEQ]);
            if smcColeta then
            begin
              smcSlot := smcBase + smcContador;
              smcEventoFaixa[smcSlot] := 15;
              smcEventoOrigem[smcSlot] := CurrentBar - janelaEQ;
              smcEventoRef[smcSlot] := smcOrigemEQTopo;
              smcEventoNascimento[smcSlot] := CurrentBar;
              smcEventoEstado[smcSlot] := SMCFato;
              smcEventoLo[smcSlot] := topoEQ;
              smcEventoHi[smcSlot] := High[janelaEQ];
              smcEventoBrutoLo[smcSlot] := topoEQ;
              smcEventoBrutoHi[smcSlot] := High[janelaEQ];
              smcContador := smcContador + 1;
            end;
          end;
          if smcColeta then
            smcOrigemEQTopo := CurrentBar - janelaEQ;
          topoEQ := High[janelaEQ];
          temTopoEQ := True;
        end;
      end;
    end;
  end;

  if calculaOBInterno or calculaOBSwing then
  begin
    volatilidade := atrWilder;
    if (not UsarATRBlocos) and (CurrentBar > 0) then
      volatilidade := somaTR / CurrentBar;

    maxBloco := High;
    minBloco := Low;
    if ((UsarATRBlocos and (CurrentBar >= 199)) or
        ((not UsarATRBlocos) and (CurrentBar > 0))) and
        ((High - Low) >= (2 * volatilidade)) then
    begin
      maxBloco := Low;
      minBloco := High;
    end;

    // Cada evento registra a origem escolhida, como deslocamento da barra de rompimento.
    for evento := 1 to 4 do
    begin
      buscas[evento] := 0;
      origens[evento] := 0;
    end;
    if calculaOBInterno and rompeTopoInterno then
      buscas[1] := CurrentBar - barraTopoInterno;
    if calculaOBInterno and rompeFundoInterno then
      buscas[2] := CurrentBar - barraFundoInterno;
    if calculaOBSwing and rompeTopo then
      buscas[3] := CurrentBar - barraTopo;
    if calculaOBSwing and rompeFundo then
      buscas[4] := CurrentBar - barraFundo;

    for evento := 1 to 4 do
    begin
      janelaBusca := buscas[evento];
      if janelaBusca > 0 then
      begin
        origem := janelaBusca;
        lado := 1;
        if (evento = 2) or (evento = 4) then
          lado := -1;

        if lado = 1 then
          extremo := -minBloco[origem]
        else
          extremo := maxBloco[origem];

        // Examinar do candle mais antigo ao mais recente. Empates preservam o primeiro.
        for deslocamento := janelaBusca - 1 downto 1 do
        begin
          if lado = 1 then
            comparar := -minBloco[deslocamento]
          else
            comparar := maxBloco[deslocamento];

          if comparar > extremo then
          begin
            extremo := comparar;
            origem := deslocamento;
          end;
        end;

        origens[evento] := origem;
      end;
    end;
    // Cada candle refaz sua lista a partir da barra anterior, inclusive em novos ticks.
    if CurrentBar = 0 then
    begin
      for leitura := 0 to 2 do
        carimbosBlocos[leitura] := 0;
    end;
    quadroAtual := Mod(CurrentBar, 3);
    quadroAnterior := Mod(CurrentBar + 2, 3);

    primeiroGrupo := 0;
    ultimoGrupo := 1;
    if not calculaOBInterno then
      primeiroGrupo := 1;
    if not calculaOBSwing then
      ultimoGrupo := 0;

    if (ModoFaixaOB = 0) and LastBarOnChart then
      for posicaoFaixa := 1 to TotalFaixasVisuais do
        faixasVisiveis[posicaoFaixa] := False;

    precoAlta := High;
    precoBaixa := Low;
    if MitigarPorFechamento then
    begin
      precoAlta := Close;
      precoBaixa := precoAlta;
    end;

    for grupo := primeiroGrupo to ultimoGrupo do
    begin
      listaAtual := quadroAtual * 2 + grupo;
      listaAnterior := quadroAnterior * 2 + grupo;
      baseAtual := listaAtual * CapacidadeBlocos;
      baseAnterior := listaAnterior * CapacidadeBlocos;
      primeiroEvento := grupo * 2 + 1;

      totalAnterior := 0;
      if (CurrentBar > 0) and (carimbosBlocos[quadroAnterior] = CurrentBar) then
        totalAnterior := quantidadesBlocos[listaAnterior];

      // O Pine limita a lista antes de verificar a mitigacao da barra.
      descarte := totalAnterior - CapacidadeBlocos;
      if origens[primeiroEvento] > 0 then
        descarte := descarte + 1;
      if origens[primeiroEvento + 1] > 0 then
        descarte := descarte + 1;
      if descarte < 0 then
        descarte := 0;

      // Inspecionar as saidas no quadro anterior, antes que este seja reciclado.
      if smcColeta and (totalAnterior > 0) then
        for leitura := 1 to totalAnterior do
        begin
          indiceAnterior := baseAnterior + leitura;
          lado := direcoes[indiceAnterior];
          smcMotivo := SMCAtivo;
          if leitura <= descarte then
            smcMotivo := SMCDescarte
          else if ((lado = 1) and (precoBaixa < inferioresBlocos[indiceAnterior]))
            or ((lado = -1) and (precoAlta > superioresBlocos[indiceAnterior])) then
            smcMotivo := SMCMitigado;
          if smcMotivo <> SMCAtivo then
          begin
            smcPosicao := 0;
            if lado = -1 then
              smcPosicao := 1;
            smcDeslocamento := CurrentBar - smcOrigemOB[indiceAnterior];
              smcSlot := smcBase + smcContador;
              smcEventoFaixa[smcSlot] := 9 + grupo * 2 + smcPosicao;
              smcEventoOrigem[smcSlot] := smcOrigemOB[indiceAnterior];
              smcEventoRef[smcSlot] := smcPivoOB[indiceAnterior];
              smcEventoNascimento[smcSlot] := criacoesBlocos[indiceAnterior];
              smcEventoEstado[smcSlot] := smcMotivo;
              smcEventoLo[smcSlot] := inferioresBlocos[indiceAnterior];
              smcEventoHi[smcSlot] := superioresBlocos[indiceAnterior];
              smcEventoBrutoLo[smcSlot] := Low[smcDeslocamento];
              smcEventoBrutoHi[smcSlot] := High[smcDeslocamento];
              smcContador := smcContador + 1;
          end;
        end;

      total := 0;
      if totalAnterior > descarte then
        for leitura := descarte + 1 to totalAnterior do
        begin
          indiceAnterior := baseAnterior + leitura;
          lado := direcoes[indiceAnterior];
          if ((lado = 1) and (precoBaixa >= inferioresBlocos[indiceAnterior]))
            or ((lado = -1) and (precoAlta <= superioresBlocos[indiceAnterior])) then
          begin
            total := total + 1;
            indiceAtual := baseAtual + total;
            direcoes[indiceAtual] := lado;
            datasBlocos[indiceAtual] := datasBlocos[indiceAnterior];
            horasBlocos[indiceAtual] := horasBlocos[indiceAnterior];
            criacoesBlocos[indiceAtual] := criacoesBlocos[indiceAnterior];
            superioresBlocos[indiceAtual] := superioresBlocos[indiceAnterior];
            inferioresBlocos[indiceAtual] := inferioresBlocos[indiceAnterior];
            if smcColeta then
            begin
              smcOrigemOB[indiceAtual] := smcOrigemOB[indiceAnterior];
              smcPivoOB[indiceAtual] := smcPivoOB[indiceAnterior];
            end;
          end
          else if calculaBreaker and (grupo = 1) and (lado = ladoOrigemBreaker) then
          begin
            quantidadesOBRemovidos[quadroOBRemovido] := quantidadesOBRemovidos[quadroOBRemovido] + 1;
            indiceOBRemovido := quadroOBRemovido * CapacidadeBlocos + quantidadesOBRemovidos[quadroOBRemovido];
            criacoesOBRemovidos[indiceOBRemovido] := criacoesBlocos[indiceAnterior];
            inferioresOBRemovidos[indiceOBRemovido] := Min(inferioresBlocos[indiceAnterior], superioresBlocos[indiceAnterior]);
            superioresOBRemovidos[indiceOBRemovido] := Max(inferioresBlocos[indiceAnterior], superioresBlocos[indiceAnterior]);
          end;
        end;

      for evento := primeiroEvento to primeiroEvento + 1 do
      begin
        origem := origens[evento];
        if (origem > 0) and (origem <= CurrentBar) then
        begin
          limiteSuperior := maxBloco[origem];
          limiteInferior := minBloco[origem];
          lado := 1;
          if evento > primeiroEvento then
            lado := -1;
          if smcColeta then
          begin
            smcMotivo := SMCAtivo;
            if ((lado = 1) and (precoBaixa < limiteInferior))
              or ((lado = -1) and (precoAlta > limiteSuperior)) then
              smcMotivo := SMCRejeitado;
            smcSlot := smcBase + smcContador;
            smcEventoFaixa[smcSlot] := 8 + evento;
            smcEventoOrigem[smcSlot] := CurrentBar - origem;
            smcEventoRef[smcSlot] := CurrentBar - buscas[evento];
            smcEventoNascimento[smcSlot] := CurrentBar;
            smcEventoEstado[smcSlot] := smcMotivo;
            smcEventoLo[smcSlot] := limiteInferior;
            smcEventoHi[smcSlot] := limiteSuperior;
            smcEventoBrutoLo[smcSlot] := Low[origem];
            smcEventoBrutoHi[smcSlot] := High[origem];
            smcContador := smcContador + 1;
          end;
          if ((lado = 1) and (precoBaixa >= limiteInferior))
            or ((lado = -1) and (precoAlta <= limiteSuperior)) then
          begin
            total := total + 1;
            indiceAtual := baseAtual + total;
            direcoes[indiceAtual] := lado;
            datasBlocos[indiceAtual] := dataCandle[origem];
            horasBlocos[indiceAtual] := horaCandle[origem];
            criacoesBlocos[indiceAtual] := CurrentBar;
            superioresBlocos[indiceAtual] := limiteSuperior;
            inferioresBlocos[indiceAtual] := limiteInferior;
            if smcColeta then
            begin
              smcOrigemOB[indiceAtual] := CurrentBar - origem;
              smcPivoOB[indiceAtual] := CurrentBar - buscas[evento];
            end;
          end;
        end;
      end;
      quantidadesBlocos[listaAtual] := total;

      if (ModoFaixaOB = 0) and LastBarOnChart
        and (((grupo = 0) and calculaBlocosInternos) or ((grupo = 1) and calculaBlocosSwing)) then
      begin
        quantidade := QuantidadeBlocosInternos;
        if grupo = 1 then
          quantidade := QuantidadeBlocosSwing;
        if quantidade < 1 then
          quantidade := 1;
        if quantidade > LimiteFaixasPorGrupo then
          quantidade := LimiteFaixasPorGrupo;
        if quantidade > total then
          quantidade := total;

        if quantidade > 0 then
          for leitura := total downto total - quantidade + 1 do
          begin
            indiceAtual := baseAtual + leitura;
            cor := RGB(49, 121, 245);
            if direcoes[indiceAtual] = -1 then
              cor := RGB(247, 86, 100);

            limiteSuperior := superioresBlocos[indiceAtual];
            limiteInferior := inferioresBlocos[indiceAtual];
            posicaoFaixa := grupo * LimiteFaixasPorGrupo + total - leitura + 1;
            centrosVisuais[posicaoFaixa] := (limiteSuperior + limiteInferior) / 2;
            alturasVisuais[posicaoFaixa] := Abs(limiteSuperior - limiteInferior) / 2;
            origensVisuais[posicaoFaixa] := datasBlocos[indiceAtual];
            coresVisuais[posicaoFaixa] := cor;
            faixasVisiveis[posicaoFaixa] := True;
          end
        else if grupo = 1 then
        begin
          PlotText("Sem OB swing ativo", clSilver, 2, 8);
        end
        else
          PlotText("Sem OB interno ativo", clSilver, 0, 8);
      end
      else if (ModoFaixaOB > 0) and (total > 0) then
      begin
        grupoFaixa := 1;
        if ModoFaixaOB >= 3 then
          grupoFaixa := 0;
        if grupo = grupoFaixa then
        begin
          ladoFaixa := 1;
          if (ModoFaixaOB = 2) or (ModoFaixaOB = 4) then
            ladoFaixa := -1;
          ordemFaixa := OrdemFaixaOB;
          if ordemFaixa < 1 then
            ordemFaixa := 1;
          encontradas := 0;
          for leitura := total downto 1 do
          begin
            indiceAtual := baseAtual + leitura;
            if direcoes[indiceAtual] = ladoFaixa then
            begin
              encontradas := encontradas + 1;
              if encontradas = ordemFaixa then
              begin
                faixaSuperior := Max(superioresBlocos[indiceAtual], inferioresBlocos[indiceAtual]);
                faixaInferior := Min(superioresBlocos[indiceAtual], inferioresBlocos[indiceAtual]);
                criacaoFaixa := criacoesBlocos[indiceAtual];
                dataFaixa := datasBlocos[indiceAtual];
                horaFaixa := horasBlocos[indiceAtual];
                faixaSelecionada := True;
              end;
            end;
          end;
        end;
      end;
    end;
    carimbosBlocos[quadroAtual] := CurrentBar + 1;

    if (ModoFaixaOB = 0) and LastBarOnChart then
    begin
      // Cada faixa tem sua propria chamada para evitar substituir o desenho anterior.
      if faixasVisiveis[1] then
        HorizontalLineCustom(centrosVisuais[1], coresVisuais[1], 1, 0, "OB interno 1", 8, 1,
          origensVisuais[1], 0, alturasVisuais[1]);
      if faixasVisiveis[2] then
        HorizontalLineCustom(centrosVisuais[2], coresVisuais[2], 1, 0, "OB interno 2", 8, 1,
          origensVisuais[2], 0, alturasVisuais[2]);
      if faixasVisiveis[3] then
        HorizontalLineCustom(centrosVisuais[3], coresVisuais[3], 1, 0, "OB interno 3", 8, 1,
          origensVisuais[3], 0, alturasVisuais[3]);
      if faixasVisiveis[4] then
        HorizontalLineCustom(centrosVisuais[4], coresVisuais[4], 1, 0, "OB interno 4", 8, 1,
          origensVisuais[4], 0, alturasVisuais[4]);
      if faixasVisiveis[5] then
        HorizontalLineCustom(centrosVisuais[5], coresVisuais[5], 1, 0, "OB interno 5", 8, 1,
          origensVisuais[5], 0, alturasVisuais[5]);
      if faixasVisiveis[6] then
        HorizontalLineCustom(centrosVisuais[6], coresVisuais[6], 1, 0, "OB interno 6", 8, 1,
          origensVisuais[6], 0, alturasVisuais[6]);
      if faixasVisiveis[7] then
        HorizontalLineCustom(centrosVisuais[7], coresVisuais[7], 1, 0, "OB interno 7", 8, 1,
          origensVisuais[7], 0, alturasVisuais[7]);
      if faixasVisiveis[8] then
        HorizontalLineCustom(centrosVisuais[8], coresVisuais[8], 1, 0, "OB interno 8", 8, 1,
          origensVisuais[8], 0, alturasVisuais[8]);
      if faixasVisiveis[9] then
        HorizontalLineCustom(centrosVisuais[9], coresVisuais[9], 1, 0, "OB interno 9", 8, 1,
          origensVisuais[9], 0, alturasVisuais[9]);
      if faixasVisiveis[10] then
        HorizontalLineCustom(centrosVisuais[10], coresVisuais[10], 1, 0, "OB interno 10", 8, 1,
          origensVisuais[10], 0, alturasVisuais[10]);
      if faixasVisiveis[11] then
        HorizontalLineCustom(centrosVisuais[11], coresVisuais[11], 1, 0, "OB interno 11", 8, 1,
          origensVisuais[11], 0, alturasVisuais[11]);
      if faixasVisiveis[12] then
        HorizontalLineCustom(centrosVisuais[12], coresVisuais[12], 1, 0, "OB interno 12", 8, 1,
          origensVisuais[12], 0, alturasVisuais[12]);
      if faixasVisiveis[13] then
        HorizontalLineCustom(centrosVisuais[13], coresVisuais[13], 1, 0, "OB interno 13", 8, 1,
          origensVisuais[13], 0, alturasVisuais[13]);
      if faixasVisiveis[14] then
        HorizontalLineCustom(centrosVisuais[14], coresVisuais[14], 1, 0, "OB interno 14", 8, 1,
          origensVisuais[14], 0, alturasVisuais[14]);
      if faixasVisiveis[15] then
        HorizontalLineCustom(centrosVisuais[15], coresVisuais[15], 1, 0, "OB interno 15", 8, 1,
          origensVisuais[15], 0, alturasVisuais[15]);
      if faixasVisiveis[16] then
        HorizontalLineCustom(centrosVisuais[16], coresVisuais[16], 1, 0, "OB interno 16", 8, 1,
          origensVisuais[16], 0, alturasVisuais[16]);
      if faixasVisiveis[17] then
        HorizontalLineCustom(centrosVisuais[17], coresVisuais[17], 1, 0, "OB interno 17", 8, 1,
          origensVisuais[17], 0, alturasVisuais[17]);
      if faixasVisiveis[18] then
        HorizontalLineCustom(centrosVisuais[18], coresVisuais[18], 1, 0, "OB interno 18", 8, 1,
          origensVisuais[18], 0, alturasVisuais[18]);
      if faixasVisiveis[19] then
        HorizontalLineCustom(centrosVisuais[19], coresVisuais[19], 1, 0, "OB interno 19", 8, 1,
          origensVisuais[19], 0, alturasVisuais[19]);
      if faixasVisiveis[20] then
        HorizontalLineCustom(centrosVisuais[20], coresVisuais[20], 1, 0, "OB interno 20", 8, 1,
          origensVisuais[20], 0, alturasVisuais[20]);

      if faixasVisiveis[21] then
        HorizontalLineCustom(centrosVisuais[21], coresVisuais[21], 1, 0, "OB swing 1", 8, 1,
          origensVisuais[21], 0, alturasVisuais[21]);
      if faixasVisiveis[22] then
        HorizontalLineCustom(centrosVisuais[22], coresVisuais[22], 1, 0, "OB swing 2", 8, 1,
          origensVisuais[22], 0, alturasVisuais[22]);
      if faixasVisiveis[23] then
        HorizontalLineCustom(centrosVisuais[23], coresVisuais[23], 1, 0, "OB swing 3", 8, 1,
          origensVisuais[23], 0, alturasVisuais[23]);
      if faixasVisiveis[24] then
        HorizontalLineCustom(centrosVisuais[24], coresVisuais[24], 1, 0, "OB swing 4", 8, 1,
          origensVisuais[24], 0, alturasVisuais[24]);
      if faixasVisiveis[25] then
        HorizontalLineCustom(centrosVisuais[25], coresVisuais[25], 1, 0, "OB swing 5", 8, 1,
          origensVisuais[25], 0, alturasVisuais[25]);
      if faixasVisiveis[26] then
        HorizontalLineCustom(centrosVisuais[26], coresVisuais[26], 1, 0, "OB swing 6", 8, 1,
          origensVisuais[26], 0, alturasVisuais[26]);
      if faixasVisiveis[27] then
        HorizontalLineCustom(centrosVisuais[27], coresVisuais[27], 1, 0, "OB swing 7", 8, 1,
          origensVisuais[27], 0, alturasVisuais[27]);
      if faixasVisiveis[28] then
        HorizontalLineCustom(centrosVisuais[28], coresVisuais[28], 1, 0, "OB swing 8", 8, 1,
          origensVisuais[28], 0, alturasVisuais[28]);
      if faixasVisiveis[29] then
        HorizontalLineCustom(centrosVisuais[29], coresVisuais[29], 1, 0, "OB swing 9", 8, 1,
          origensVisuais[29], 0, alturasVisuais[29]);
      if faixasVisiveis[30] then
        HorizontalLineCustom(centrosVisuais[30], coresVisuais[30], 1, 0, "OB swing 10", 8, 1,
          origensVisuais[30], 0, alturasVisuais[30]);
      if faixasVisiveis[31] then
        HorizontalLineCustom(centrosVisuais[31], coresVisuais[31], 1, 0, "OB swing 11", 8, 1,
          origensVisuais[31], 0, alturasVisuais[31]);
      if faixasVisiveis[32] then
        HorizontalLineCustom(centrosVisuais[32], coresVisuais[32], 1, 0, "OB swing 12", 8, 1,
          origensVisuais[32], 0, alturasVisuais[32]);
      if faixasVisiveis[33] then
        HorizontalLineCustom(centrosVisuais[33], coresVisuais[33], 1, 0, "OB swing 13", 8, 1,
          origensVisuais[33], 0, alturasVisuais[33]);
      if faixasVisiveis[34] then
        HorizontalLineCustom(centrosVisuais[34], coresVisuais[34], 1, 0, "OB swing 14", 8, 1,
          origensVisuais[34], 0, alturasVisuais[34]);
      if faixasVisiveis[35] then
        HorizontalLineCustom(centrosVisuais[35], coresVisuais[35], 1, 0, "OB swing 15", 8, 1,
          origensVisuais[35], 0, alturasVisuais[35]);
      if faixasVisiveis[36] then
        HorizontalLineCustom(centrosVisuais[36], coresVisuais[36], 1, 0, "OB swing 16", 8, 1,
          origensVisuais[36], 0, alturasVisuais[36]);
      if faixasVisiveis[37] then
        HorizontalLineCustom(centrosVisuais[37], coresVisuais[37], 1, 0, "OB swing 17", 8, 1,
          origensVisuais[37], 0, alturasVisuais[37]);
      if faixasVisiveis[38] then
        HorizontalLineCustom(centrosVisuais[38], coresVisuais[38], 1, 0, "OB swing 18", 8, 1,
          origensVisuais[38], 0, alturasVisuais[38]);
      if faixasVisiveis[39] then
        HorizontalLineCustom(centrosVisuais[39], coresVisuais[39], 1, 0, "OB swing 19", 8, 1,
          origensVisuais[39], 0, alturasVisuais[39]);
      if faixasVisiveis[40] then
        HorizontalLineCustom(centrosVisuais[40], coresVisuais[40], 1, 0, "OB swing 20", 8, 1,
          origensVisuais[40], 0, alturasVisuais[40]);
    end;
  end;

  if (ModoFaixaOB >= 1) and (ModoFaixaOB <= 4) then
  begin
    cor := RGB(49, 121, 245);
    if (ModoFaixaOB = 2) or (ModoFaixaOB = 4) then
      cor := RGB(247, 86, 100);

    if AncorarFaixaOB then
    begin
      if LastBarOnChart and faixaSelecionada then
      begin
        centroBloco := (faixaSuperior + faixaInferior) / 2;
        meiaAlturaBloco := (faixaSuperior - faixaInferior) / 2;
        if horaFaixa = 0 then
          HorizontalLineCustom(centroBloco, cor, 1, 0, "", 8, 1,
            dataFaixa, 0, meiaAlturaBloco)
        else
        begin
          // Aplicar o horario somente ao dia de origem. Nos demais dias, usar a sessao toda.
          HorizontalLineCustom(centroBloco, cor, 1, 0, "", 8, 1,
            dataFaixa, dataFaixa, meiaAlturaBloco, horaFaixa, 2359);
          if dataCandle > dataFaixa then
            HorizontalLineCustom(centroBloco, cor, 1, 0, "", 8, 1,
              CalcDate(dataFaixa, 1), 0, meiaAlturaBloco);
        end;
      end;
    end
    else if faixaSelecionada and ((not faixaSelecionada[1]) or (criacaoFaixa = criacaoFaixa[1])) then
    begin
      // Um intervalo sem plot separa blocos diferentes no preenchimento entre linhas.
      Plot(faixaSuperior);
      Plot2(faixaInferior);
      SetPlotColor(1, cor);
      SetPlotColor(2, cor);
    end
    else
    begin
      NoPlot(1);
      NoPlot(2);
    end;
  end;

  if calculaFVG or calculaBreaker or flipDetectaFVG then
  begin
    ladoNovoFVG := 0;
    retornoFVG := 0;
    somaRetornosFVG := 0;
    limiarFVG := 0;
    if CurrentBar > 0 then
    begin
      if Open[1] <> 0 then
        retornoFVG := (Close[1] - Open[1]) / Open[1];
      somaRetornosFVG := somaRetornosFVG[1] + Abs(retornoFVG);
      if FiltroAutomaticoFVG then
        limiarFVG := 2 * somaRetornosFVG / CurrentBar;
    end;

    if CurrentBar >= 2 then
    begin
      if (Low > High[2]) and (Close[1] > High[2]) and (retornoFVG > limiarFVG) then
        ladoNovoFVG := 1
      else if (High < Low[2]) and (Close[1] < Low[2]) and (-retornoFVG > limiarFVG) then
        ladoNovoFVG := -1;
    end;
  end;

  if calculaFVG then
  begin
    extensaoEfetivaFVG := ExtensaoFVG;
    if extensaoEfetivaFVG < 0 then
      extensaoEfetivaFVG := 0;

    // Preservar a barra anterior durante a reavaliacao da barra atual.
    if CurrentBar = 0 then
      for leituraFVG := 0 to 2 do
        carimbosFVG[leituraFVG] := 0;
    quadroFVG := Mod(CurrentBar, 3);
    quadroAnteriorFVG := Mod(CurrentBar + 2, 3);
    baseFVG := quadroFVG * CapacidadeFVG;
    baseAnteriorFVG := quadroAnteriorFVG * CapacidadeFVG;
    totalAnteriorFVG := 0;
    if (CurrentBar > 0) and (carimbosFVG[quadroAnteriorFVG] = CurrentBar) then
      totalAnteriorFVG := quantidadesFVG[quadroAnteriorFVG];

    // Guardar os sobreviventes do mais recente ao mais antigo, reservando a primeira posicao para o novo gap.
    reservaFVG := 0;
    if ladoNovoFVG <> 0 then
      reservaFVG := 1;
    totalFVG := reservaFVG;
    if totalAnteriorFVG > 0 then
      for leituraFVG := 1 to totalAnteriorFVG do
      begin
        entradaFVG := baseAnteriorFVG + leituraFVG;
        if smcColeta then
        begin
          smcMotivo := SMCAtivo;
          if ((direcoesFVG[entradaFVG] = 1) and (Low < inferioresFVG[entradaFVG]))
            or ((direcoesFVG[entradaFVG] = -1) and (High > superioresFVG[entradaFVG])) then
            smcMotivo := SMCMitigado
          else if totalFVG >= CapacidadeFVG then
            smcMotivo := SMCDescarte;
          if smcMotivo <> SMCAtivo then
          begin
            smcFaixa := 13;
            if direcoesFVG[entradaFVG] = -1 then
              smcFaixa := 14;
            smcSlot := smcBase + smcContador;
            smcEventoFaixa[smcSlot] := smcFaixa;
            smcEventoOrigem[smcSlot] := formacoesFVG[entradaFVG] - 1;
            smcEventoRef[smcSlot] := formacoesFVG[entradaFVG] - 2;
            smcEventoNascimento[smcSlot] := formacoesFVG[entradaFVG];
            smcEventoEstado[smcSlot] := smcMotivo;
            smcEventoLo[smcSlot] := inferioresFVG[entradaFVG];
            smcEventoHi[smcSlot] := superioresFVG[entradaFVG];
            smcEventoBrutoLo[smcSlot] := inferioresFVG[entradaFVG];
            smcEventoBrutoHi[smcSlot] := superioresFVG[entradaFVG];
            smcContador := smcContador + 1;
          end;
        end;
        if (totalFVG < CapacidadeFVG) and
          (((direcoesFVG[entradaFVG] = 1) and (Low >= inferioresFVG[entradaFVG]))
          or ((direcoesFVG[entradaFVG] = -1) and (High <= superioresFVG[entradaFVG]))) then
        begin
          totalFVG := totalFVG + 1;
          saidaFVG := baseFVG + totalFVG;
          direcoesFVG[saidaFVG] := direcoesFVG[entradaFVG];
          formacoesFVG[saidaFVG] := formacoesFVG[entradaFVG];
          inferioresFVG[saidaFVG] := inferioresFVG[entradaFVG];
          superioresFVG[saidaFVG] := superioresFVG[entradaFVG];
          datasOrigemFVG[saidaFVG] := datasOrigemFVG[entradaFVG];
          horasOrigemFVG[saidaFVG] := horasOrigemFVG[entradaFVG];
          datasDireitaFVG[saidaFVG] := datasDireitaFVG[entradaFVG];
          horasDireitaFVG[saidaFVG] := horasDireitaFVG[entradaFVG];
          if CurrentBar - formacoesFVG[saidaFVG] <= extensaoEfetivaFVG then
          begin
            datasDireitaFVG[saidaFVG] := dataCandle;
            horasDireitaFVG[saidaFVG] := horaCandle;
          end;
        end;
      end;

    if ladoNovoFVG <> 0 then
    begin
      saidaFVG := baseFVG + 1;
      direcoesFVG[saidaFVG] := ladoNovoFVG;
      formacoesFVG[saidaFVG] := CurrentBar;
      datasOrigemFVG[saidaFVG] := dataCandle[1];
      horasOrigemFVG[saidaFVG] := horaCandle[1];
      datasDireitaFVG[saidaFVG] := dataCandle;
      horasDireitaFVG[saidaFVG] := horaCandle;
      if ladoNovoFVG = 1 then
      begin
        inferioresFVG[saidaFVG] := High[2];
        superioresFVG[saidaFVG] := Low;
      end
      else
      begin
        inferioresFVG[saidaFVG] := High;
        superioresFVG[saidaFVG] := Low[2];
      end;
      if smcColeta then
      begin
        smcFaixa := 13;
        if ladoNovoFVG = -1 then
          smcFaixa := 14;
        smcSlot := smcBase + smcContador;
        smcEventoFaixa[smcSlot] := smcFaixa;
        smcEventoOrigem[smcSlot] := CurrentBar - 1;
        smcEventoRef[smcSlot] := CurrentBar - 2;
        smcEventoNascimento[smcSlot] := CurrentBar;
        smcEventoEstado[smcSlot] := SMCAtivo;
        smcEventoLo[smcSlot] := inferioresFVG[saidaFVG];
        smcEventoHi[smcSlot] := superioresFVG[saidaFVG];
        smcEventoBrutoLo[smcSlot] := inferioresFVG[saidaFVG];
        smcEventoBrutoHi[smcSlot] := superioresFVG[saidaFVG];
        smcContador := smcContador + 1;
      end;
    end;
    quantidadesFVG[quadroFVG] := totalFVG;
    carimbosFVG[quadroFVG] := CurrentBar + 1;

    if exibeFVG and LastBarOnChart then
    begin
      visiveisFVG := totalFVG;
      if visiveisFVG > LimiteFaixasFVG then
        visiveisFVG := LimiteFaixasFVG;
      if visiveisFVG > 0 then
        for posicaoFVG := 1 to visiveisFVG do
        begin
          saidaFVG := baseFVG + posicaoFVG;
          centrosFVG[posicaoFVG] := (superioresFVG[saidaFVG] + inferioresFVG[saidaFVG]) / 2;
          alturasFVG[posicaoFVG] := (superioresFVG[saidaFVG] - inferioresFVG[saidaFVG]) / 2;
          coresFVG[posicaoFVG] := CorFVGAlta;
          if direcoesFVG[saidaFVG] = -1 then
            coresFVG[posicaoFVG] := CorFVGBaixa;

          diasInicioFVG[posicaoFVG] := datasOrigemFVG[saidaFVG];
          horasInicioFVG[posicaoFVG] := horasOrigemFVG[saidaFVG];
          diasFimFVG[posicaoFVG] := datasDireitaFVG[saidaFVG];
          horasFimFVG[posicaoFVG] := horasDireitaFVG[saidaFVG];
          diasFimPrimeiroTrechoFVG[posicaoFVG] := diasFimFVG[posicaoFVG];
          horasFimPrimeiroTrechoFVG[posicaoFVG] := horasFimFVG[posicaoFVG];
          temDiasIntermediariosFVG[posicaoFVG] := False;

          // Restringir o horario apenas nas duas datas que limitam a faixa.
          if diasInicioFVG[posicaoFVG] <> diasFimFVG[posicaoFVG] then
          begin
            diasFimPrimeiroTrechoFVG[posicaoFVG] := diasInicioFVG[posicaoFVG];
            horasFimPrimeiroTrechoFVG[posicaoFVG] := 2359;
            primeirosDiasIntermediariosFVG[posicaoFVG] := CalcDate(diasInicioFVG[posicaoFVG], 1);
            ultimosDiasIntermediariosFVG[posicaoFVG] := CalcDate(diasFimFVG[posicaoFVG], -1);
            temDiasIntermediariosFVG[posicaoFVG] :=
              primeirosDiasIntermediariosFVG[posicaoFVG] <= ultimosDiasIntermediariosFVG[posicaoFVG];
          end;
        end;

      // Cada trecho tem uma chamada propria, como no desenho dos Order Blocks.
      if 1 <= visiveisFVG then
      begin
        HorizontalLineCustom(centrosFVG[1], coresFVG[1], 1, 0, "FVG", 8, 1,
          diasInicioFVG[1], diasFimPrimeiroTrechoFVG[1], alturasFVG[1],
          horasInicioFVG[1], horasFimPrimeiroTrechoFVG[1]);
        if temDiasIntermediariosFVG[1] then
          HorizontalLineCustom(centrosFVG[1], coresFVG[1], 1, 0, "", 8, 1,
            primeirosDiasIntermediariosFVG[1], ultimosDiasIntermediariosFVG[1], alturasFVG[1]);
        if diasInicioFVG[1] <> diasFimFVG[1] then
          HorizontalLineCustom(centrosFVG[1], coresFVG[1], 1, 0, "", 8, 1,
            diasFimFVG[1], diasFimFVG[1], alturasFVG[1], 0, horasFimFVG[1]);
      end;
      if 2 <= visiveisFVG then
      begin
        HorizontalLineCustom(centrosFVG[2], coresFVG[2], 1, 0, "FVG", 8, 1,
          diasInicioFVG[2], diasFimPrimeiroTrechoFVG[2], alturasFVG[2],
          horasInicioFVG[2], horasFimPrimeiroTrechoFVG[2]);
        if temDiasIntermediariosFVG[2] then
          HorizontalLineCustom(centrosFVG[2], coresFVG[2], 1, 0, "", 8, 1,
            primeirosDiasIntermediariosFVG[2], ultimosDiasIntermediariosFVG[2], alturasFVG[2]);
        if diasInicioFVG[2] <> diasFimFVG[2] then
          HorizontalLineCustom(centrosFVG[2], coresFVG[2], 1, 0, "", 8, 1,
            diasFimFVG[2], diasFimFVG[2], alturasFVG[2], 0, horasFimFVG[2]);
      end;
      if 3 <= visiveisFVG then
      begin
        HorizontalLineCustom(centrosFVG[3], coresFVG[3], 1, 0, "FVG", 8, 1,
          diasInicioFVG[3], diasFimPrimeiroTrechoFVG[3], alturasFVG[3],
          horasInicioFVG[3], horasFimPrimeiroTrechoFVG[3]);
        if temDiasIntermediariosFVG[3] then
          HorizontalLineCustom(centrosFVG[3], coresFVG[3], 1, 0, "", 8, 1,
            primeirosDiasIntermediariosFVG[3], ultimosDiasIntermediariosFVG[3], alturasFVG[3]);
        if diasInicioFVG[3] <> diasFimFVG[3] then
          HorizontalLineCustom(centrosFVG[3], coresFVG[3], 1, 0, "", 8, 1,
            diasFimFVG[3], diasFimFVG[3], alturasFVG[3], 0, horasFimFVG[3]);
      end;
      if 4 <= visiveisFVG then
      begin
        HorizontalLineCustom(centrosFVG[4], coresFVG[4], 1, 0, "FVG", 8, 1,
          diasInicioFVG[4], diasFimPrimeiroTrechoFVG[4], alturasFVG[4],
          horasInicioFVG[4], horasFimPrimeiroTrechoFVG[4]);
        if temDiasIntermediariosFVG[4] then
          HorizontalLineCustom(centrosFVG[4], coresFVG[4], 1, 0, "", 8, 1,
            primeirosDiasIntermediariosFVG[4], ultimosDiasIntermediariosFVG[4], alturasFVG[4]);
        if diasInicioFVG[4] <> diasFimFVG[4] then
          HorizontalLineCustom(centrosFVG[4], coresFVG[4], 1, 0, "", 8, 1,
            diasFimFVG[4], diasFimFVG[4], alturasFVG[4], 0, horasFimFVG[4]);
      end;
      if 5 <= visiveisFVG then
      begin
        HorizontalLineCustom(centrosFVG[5], coresFVG[5], 1, 0, "FVG", 8, 1,
          diasInicioFVG[5], diasFimPrimeiroTrechoFVG[5], alturasFVG[5],
          horasInicioFVG[5], horasFimPrimeiroTrechoFVG[5]);
        if temDiasIntermediariosFVG[5] then
          HorizontalLineCustom(centrosFVG[5], coresFVG[5], 1, 0, "", 8, 1,
            primeirosDiasIntermediariosFVG[5], ultimosDiasIntermediariosFVG[5], alturasFVG[5]);
        if diasInicioFVG[5] <> diasFimFVG[5] then
          HorizontalLineCustom(centrosFVG[5], coresFVG[5], 1, 0, "", 8, 1,
            diasFimFVG[5], diasFimFVG[5], alturasFVG[5], 0, horasFimFVG[5]);
      end;
    end;
  end;

  if calculaBreaker then
  begin
    quadroBreaker := Mod(CurrentBar, 3);
    quadroAnteriorBreaker := Mod(CurrentBar + 2, 3);
    baseBreaker := quadroBreaker * CapacidadeBreaker;
    baseAnteriorBreaker := quadroAnteriorBreaker * CapacidadeBreaker;
    totalAnteriorBreaker := 0;
    if (CurrentBar > 0) and (carimbosBreaker[quadroAnteriorBreaker] = CurrentBar) then
      totalAnteriorBreaker := quantidadesBreaker[quadroAnteriorBreaker];

    totalBreaker := 0;
    if CurrentBar > 0 then
      fechamentoC := Close[1] * ladoOrigemBreaker;

    // A, B e C sao os tres candles ja fechados anteriores ao candle atual.
    if (CurrentBar >= 4) and (ladoNovoFVG[1] = -ladoOrigemBreaker) then
    begin
      aberturaA := Open[3] * ladoOrigemBreaker;
      fechamentoA := Close[3] * ladoOrigemBreaker;
      fechamentoB := Close[2] * ladoOrigemBreaker;
      if ladoOrigemBreaker = 1 then
      begin
        extremoA := Low[3];
        extremosAB := Min(extremoA, Low[2]);
        inferFVGFechado := High[1];
        superFVGFechado := Low[3];
      end
      else
      begin
        extremoA := -High[3];
        extremosAB := Min(extremoA, -High[2]);
        inferFVGFechado := High[3];
        superFVGFechado := Low[1];
      end;
      diaBreaker := dataCandle[1];
      horaBreaker := horaCandle[1];

      // Examinar primeiro as remocoes em C, depois B e A.
      for atrasoOB := 1 to 3 do
      begin
        quadroConsultaOB := Mod(CurrentBar + QuadrosOBRemovidos - atrasoOB, QuadrosOBRemovidos);
        if (carimbosOBRemovidos[quadroConsultaOB] = CurrentBar - atrasoOB + 1)
          and (quantidadesOBRemovidos[quadroConsultaOB] > 0) then
          for leituraBreaker := quantidadesOBRemovidos[quadroConsultaOB] downto 1 do
          begin
            entradaBreaker := quadroConsultaOB * CapacidadeBlocos + leituraBreaker;
            inferBreaker := inferioresOBRemovidos[entradaBreaker];
            superBreaker := superioresOBRemovidos[entradaBreaker];
            // Multiplicar pelo lado original reduz a travessia espelhada a um movimento descendente.
            chegadaBreaker := Max(inferBreaker * ladoOrigemBreaker, superBreaker * ladoOrigemBreaker);
            saidaTravessia := Min(inferBreaker * ladoOrigemBreaker, superBreaker * ladoOrigemBreaker);
            if (totalBreaker < CapacidadeBreaker) and (criacoesOBRemovidos[entradaBreaker] < CurrentBar - 3)
              and (aberturaA > chegadaBreaker) and (fechamentoC < saidaTravessia)
              and ((extremoA > chegadaBreaker) or (fechamentoA <= chegadaBreaker))
              and ((extremosAB > chegadaBreaker) or (fechamentoB <= chegadaBreaker))
              and (Max(inferBreaker, inferFVGFechado) < Min(superBreaker, superFVGFechado)) then
            begin
              totalBreaker := totalBreaker + 1;
              saidaBreaker := baseBreaker + totalBreaker;
              inferioresBreaker[saidaBreaker] := inferBreaker;
              superioresBreaker[saidaBreaker] := superBreaker;
              datasBreaker[saidaBreaker] := diaBreaker;
              horasBreaker[saidaBreaker] := horaBreaker;
            end;
          end;
      end;
    end;

    // Depois das novas confirmacoes, copiar as faixas anteriores que ainda estao ativas.
    if totalAnteriorBreaker > 0 then
      for leituraBreaker := 1 to totalAnteriorBreaker do
      begin
        entradaBreaker := baseAnteriorBreaker + leituraBreaker;
        inferBreaker := inferioresBreaker[entradaBreaker];
        superBreaker := superioresBreaker[entradaBreaker];
        chegadaBreaker := Max(inferBreaker * ladoOrigemBreaker, superBreaker * ladoOrigemBreaker);
        if (totalBreaker < CapacidadeBreaker) and (fechamentoC <= chegadaBreaker) then
        begin
          totalBreaker := totalBreaker + 1;
          saidaBreaker := baseBreaker + totalBreaker;
          inferioresBreaker[saidaBreaker] := inferBreaker;
          superioresBreaker[saidaBreaker] := superBreaker;
          datasBreaker[saidaBreaker] := datasBreaker[entradaBreaker];
          horasBreaker[saidaBreaker] := horasBreaker[entradaBreaker];
        end;
      end;
    quantidadesBreaker[quadroBreaker] := totalBreaker;
    carimbosBreaker[quadroBreaker] := CurrentBar + 1;

    ordemBreaker := OrdemFaixaOB;
    if ordemBreaker < 1 then
      ordemBreaker := 1;
    if LastBarOnChart and (ordemBreaker <= totalBreaker) then
    begin
      saidaBreaker := baseBreaker + ordemBreaker;
      inferBreaker := inferioresBreaker[saidaBreaker];
      superBreaker := superioresBreaker[saidaBreaker];
      centroBreaker := (inferBreaker + superBreaker) / 2;
      alturaBreaker := (superBreaker - inferBreaker) / 2;
      diaBreaker := datasBreaker[saidaBreaker];
      horaBreaker := horasBreaker[saidaBreaker];
      fimDiaBreaker := 0;
      if horaBreaker <> 0 then
        fimDiaBreaker := diaBreaker;
      HorizontalLineCustom(centroBreaker, clLtGray, 1, 0, "Breaker", 8, 1,
        diaBreaker, fimDiaBreaker, alturaBreaker, horaBreaker, 2359);
      if (horaBreaker <> 0) and (dataCandle > diaBreaker) then
        HorizontalLineCustom(centroBreaker, clLtGray, 1, 0, "", 8, 1,
          CalcDate(diaBreaker, 1), 0, alturaBreaker);
    end;
  end;

  if smcColeta then
  begin
    smcLotes[smcQuadro] := smcContador;
    smcCarimbos[smcQuadro] := CurrentBar + 1;
  end;

  // t+1 fecha o lote de t. LastBarOnChart tambem vale durante a formacao.
  if smcCalcula and (CurrentBar > 0) and (CurrentBar - 1 > smcUltimaPublicacao) then
  begin
    smcBarra := CurrentBar - 1;
    smcQuadro := Mod(smcBarra, 2);
    smcLoteAusente := (smcCarimbos[smcQuadro] <> CurrentBar)
      or (smcUltimaPublicacao <> CurrentBar - 2);
    if not smcLoteAusente then
    begin
      smcOrigemPublicada := smcBarra;
      smcUltimaPublicacao := smcBarra;
      smcPrimeiro := smcQuadro * SMCLote;
      smcUltimo := smcPrimeiro + smcLotes[smcQuadro] - 1;
      smcDataConfirmada := dataCandle[1];
      smcHoraConfirmada := horaCandle[1];
      smcTick := MinPriceIncrement;
      smcBarraValida := smcConfigValida and (smcTick > 0) and (High[1] >= Low[1])
        and (High[1] >= Max(Open[1], Close[1])) and (Low[1] <= Min(Open[1], Close[1]));
      if smcBarraValida then
      begin
        smcBarrasValidas := smcBarrasValidas + 1;
        smcFechamentoTicks := Round(Close[1] / smcTick);
        smcTR := High[1] - Low[1];
        if smcTemAnterior and (CurrentBar > 1) then
        begin
          smcAnteriorTicks := Round(Close[2] / smcTick);
          smcTR := Max(smcTR, Max(Abs(High[1] - Close[2]), Abs(Low[1] - Close[2])));
        end;
        if smcAmostrasATR < PeriodoATRSMC then
        begin
          smcAmostrasATR := smcAmostrasATR + 1;
          smcSomaTR := smcSomaTR + smcTR;
          if smcAmostrasATR = PeriodoATRSMC then
            smcATR := smcSomaTR / PeriodoATRSMC;
        end
        else
          smcATR := ((PeriodoATRSMC - 1) * smcATR + smcTR) / PeriodoATRSMC;
        smcATRDisponivel := smcAmostrasATR = PeriodoATRSMC;
      end
      else
      begin
        smcBarrasValidas := 0;
        smcAmostrasATR := 0;
        smcSomaTR := 0;
        smcATR := 0;
        smcATRDisponivel := False;
      end;

      if idmCalcula and smcBarraValida then
        for idmLado := 1 to 2 do
        begin
          idmBase := (idmLado - 1) * IDMCapacidade;
          idmExtremoTicks := Round(Low[1] / smcTick);
          if idmLado = 2 then
            idmExtremoTicks := Round(High[1] / smcTick);
          if idmUsados[idmLado] > 0 then
            for idmSlot := idmBase to idmBase + idmUsados[idmLado] - 1 do
              if (idmEstado[idmSlot] = IDMAtivo) and (idmAtivacao[idmSlot] < smcBarra) then
                if ((idmLado = 1) and (idmExtremoTicks < idmNivelTicks[idmSlot]))
                  or ((idmLado = 2) and (idmExtremoTicks > idmNivelTicks[idmSlot])) then
                begin
                  idmEstado[idmSlot] := IDMTomado;
                  idmFim[idmSlot] := smcBarra;
                  idmDiaFim[idmSlot] := smcDataConfirmada;
                  idmHoraFim[idmSlot] := smcHoraConfirmada;
                end;
        end;

      for smcLado := 1 to 4 do
      begin
        smcPivoNaBarra[smcLado] := -1;
        smcBreakNaBarra[smcLado] := -1;
        if flipCalcula then
        begin
          flipPivoAdmitido[smcLado] := -1;
          flipPublicadoSlot[smcLado] := -1;
          flipQualPublicado[smcLado] := -1;
          flipAlvoContinuacao[smcLado] := -1;
          flipContinuacaoSlot[smcLado] := -1;
          flipCorrecaoContinuacao[smcLado] := -1;
        end;
      end;
      if smcUltimo >= smcPrimeiro then
        for smcIndice := smcPrimeiro to smcUltimo do
        begin
          smcFaixa := smcEventoFaixa[smcIndice];
          smcEventoQualificacao[smcIndice] := 0;
          smcEventoBarraQualificacao[smcIndice] := -1;
          if smcFaixa <= 4 then
          begin
            smcPivoNaBarra[smcFaixa] := smcIndice;
            smcEventoRef[smcIndice] := smcPivoConfirmado[smcFaixa];
          end
          else if smcFaixa <= 8 then
          begin
            smcLado := smcFaixa - 4;
            smcBreakNaBarra[smcLado] := smcIndice;
            smcEventoRef[smcIndice] := smcPivoConfirmado[smcLado];
            if smcPivoNaBarra[smcLado] >= 0 then
              smcEventoRef[smcIndice] := smcBarra;
          end;
        end;

      // Consultar o historico anterior a t. Pivos de t entram depois das rupturas.
      for smcEscala := 0 to 1 do
      begin
        smcAntigoFluxo := smcFluxo[smcEscala];
        smcMotivoFluxo := 0;
        smcHistBase := smcEscala * SMCHistPivos;
        smcHistQtd := smcHistTotal[smcEscala];
        if not smcBarraValida then
          smcMotivoFluxo := SMCDadosInvalidos
        else if smcAntigoFluxo = SMCTransicao then
        begin
          if smcTemExtremoTransicao[smcEscala] then
          begin
            smcNivelTicks := Round(smcExtremoTransicao[smcEscala] / smcTick);
            if (smcFechamentoTicks - smcNivelTicks) * smcDirecaoTransicao[smcEscala] > 0 then
            begin
              smcFluxo[smcEscala] := 0;
              smcContexto[smcEscala] := smcContexto[smcEscala] + 1;
              smcMotivoFluxo := SMCRetornoExtremo;
            end;
          end;
        end
        else if smcProtecaoConfirmacao[smcEscala] >= 0 then
        begin
          smcNivelTicks := Round(smcProtecaoPreco[smcEscala] / smcTick);
          if (smcFechamentoTicks - smcNivelTicks) * smcAntigoFluxo < 0 then
          begin
            smcFluxo[smcEscala] := SMCTransicao;
            smcDirecaoTransicao[smcEscala] := smcAntigoFluxo;
            smcDesdeTransicao[smcEscala] := smcBarra;
            smcContexto[smcEscala] := smcContexto[smcEscala] + 1;
            smcMotivoFluxo := SMCPerdaProtecao;
            smcProtecaoConfirmacao[smcEscala] := -1;
            smcTemExtremoTransicao[smcEscala] := False;
            if smcHistQtd > 0 then
            begin
              smcPosicao := smcHistInicio[smcEscala] + smcHistQtd - 1;
              smcHistPos := smcHistBase + Mod(smcPosicao, SMCHistPivos);
              if (smcHistLado[smcHistPos] <> smcAntigoFluxo) and (smcHistQtd > 1) then
                smcHistPos := smcHistBase + Mod(smcPosicao - 1, SMCHistPivos);
              if smcHistLado[smcHistPos] = smcAntigoFluxo then
              begin
                smcTemExtremoTransicao[smcEscala] := True;
                smcExtremoTransicao[smcEscala] := smcHistPreco[smcHistPos];
              end;
            end;
          end;
        end;
        for smcLado := smcEscala * 2 + 1 to smcEscala * 2 + 2 do
        begin
          smcDirecao := 1;
          if Mod(smcLado, 2) = 0 then
            smcDirecao := -1;
          smcQuebra := smcEspera[smcLado];
          smcResultado := 0;
          if smcQuebra >= 0 then
          begin
            if not smcBarraValida then
              smcResultado := SMCDadosInvalidos
            else if smcPivoNaBarra[smcLado] >= 0 then
              smcResultado := SMCAlvoSubstituido
            else if smcEsperaContexto[smcLado] <> smcContexto[smcEscala] then
              smcResultado := SMCContextoPerdido
            else
            begin
              smcNivelTicks := Round(smcEventoLo[smcQuebra] / smcTick);
              smcDistanciaTicks := (smcFechamentoTicks - smcNivelTicks) * smcDirecao;
              if smcDistanciaTicks <= 0 then
                smcResultado := SMCCancelado
              else if (smcBarra - smcEventoNascimento[smcQuebra] <= SMCPrazoRuptura)
                and (smcDistanciaTicks >= BufferRupturaSMCTicks) then
                smcResultado := SMCQualificado
              else if smcBarra - smcEventoNascimento[smcQuebra] >= SMCPrazoRuptura then
                smcResultado := SMCExpirado;
            end;
            if smcResultado <> 0 then
            begin
              smcEventoQualificacao[smcQuebra] := smcResultado;
              smcEventoBarraQualificacao[smcQuebra] := smcBarra;
              smcEspera[smcLado] := -1;
            end;
          end;

          if smcBreakNaBarra[smcLado] >= 0 then
          begin
            smcQuebra := smcBreakNaBarra[smcLado];
            smcQuebraRef := smcEventoRef[smcQuebra];
            if (smcQuebraRef < 0) or (smcQuebraRef >= smcBarra) then
              smcResultado := SMCTargetNotPreknown
            else if not (smcBarraValida and smcTemAnterior and smcPivoValido[smcLado]) then
              smcResultado := SMCDadosInvalidos
            else
            begin
              smcNivelTicks := Round(smcEventoLo[smcQuebra] / smcTick);
              smcDistanciaTicks := (smcFechamentoTicks - smcNivelTicks) * smcDirecao;
              smcCruzamentoValido := ((smcAnteriorTicks - smcNivelTicks) * smcDirecao <= 0)
                and (smcDistanciaTicks > 0);
              smcResultado := SMCSemCruzamento;
              if smcCruzamentoValido then
              begin
                if smcDistanciaTicks >= BufferRupturaSMCTicks then
                  smcResultado := SMCQualificado
                else
                begin
                  smcResultado := SMCAguardando;
                  smcEspera[smcLado] := smcQuebra;
                  smcEsperaContexto[smcLado] := smcContexto[smcEscala];
                end;
              end;
            end;
            smcEventoQualificacao[smcQuebra] := smcResultado;
            if smcResultado <> SMCAguardando then
              smcEventoBarraQualificacao[smcQuebra] := smcBarra;
          end;

          // Uma ruptura causal usa somente contexto disponivel antes da barra.
          if smcResultado = SMCQualificado then
          begin
            smcQuebraOrigem := smcEventoOrigem[smcQuebra];
            smcMudaFluxo := False;
            smcAlvo := -1;
            smcHistOposto := -1;
            // Em um historico alternado, os dois ultimos representam os dois lados.
            if smcHistQtd > 0 then
            begin
              smcHistRecente := smcHistBase + Mod(smcHistInicio[smcEscala] + smcHistQtd - 1, SMCHistPivos);
              smcHistSegundo := -1;
              if smcHistQtd > 1 then
                smcHistSegundo := smcHistBase + Mod(smcHistInicio[smcEscala] + smcHistQtd - 2, SMCHistPivos);
              if smcHistLado[smcHistRecente] = smcDirecao then
              begin
                smcAlvo := smcHistRecente;
                smcHistOposto := smcHistSegundo;
              end
              else
              begin
                smcAlvo := smcHistSegundo;
                smcHistOposto := smcHistRecente;
              end;
              if smcAlvo >= 0 then
                if smcHistConfirmacao[smcAlvo] <> smcEventoRef[smcQuebra] then
                  smcAlvo := -1;
            end;
            if (smcAlvo >= 0) and (smcFluxo[smcEscala] = 0) and (smcHistQtd >= 4) then
            begin
              smcHistTerceiro := smcHistBase + Mod(smcHistInicio[smcEscala] + smcHistQtd - 3, SMCHistPivos);
              smcHistQuarto := smcHistBase + Mod(smcHistInicio[smcEscala] + smcHistQtd - 4, SMCHistPivos);
              smcCoerente :=
                ((Round(smcHistPreco[smcHistRecente] / smcTick) - Round(smcHistPreco[smcHistTerceiro] / smcTick))
                  * smcDirecao > ToleranciaSMCTicks)
                and ((Round(smcHistPreco[smcHistSegundo] / smcTick) - Round(smcHistPreco[smcHistQuarto] / smcTick))
                  * smcDirecao > ToleranciaSMCTicks);
              smcMudaFluxo := smcCoerente;
            end
            else if (smcAlvo >= 0) and (smcFluxo[smcEscala] = SMCTransicao)
              and (smcDirecao = -smcDirecaoTransicao[smcEscala])
              and (smcQuebraOrigem > smcDesdeTransicao[smcEscala]) and (smcHistOposto >= 0) then
              smcMudaFluxo := smcHistOrigem[smcHistOposto] > smcQuebraOrigem;

            if smcMudaFluxo then
            begin
              smcFluxo[smcEscala] := smcDirecao;
              smcContexto[smcEscala] := smcContexto[smcEscala] + 1;
            end;

            if (smcAlvo >= 0) and (smcFluxo[smcEscala] = smcDirecao) and
              (smcMudaFluxo or (smcEventoBrutoLo[smcQuebra] <> -smcDirecao)) then
            begin
              smcProtecaoConfirmacao[smcEscala] := -1;
              if smcHistOposto >= 0 then
                if smcHistOrigem[smcHistOposto] > smcQuebraOrigem then
                begin
                  smcProtecaoConfirmacao[smcEscala] := smcHistConfirmacao[smcHistOposto];
                  smcProtecaoOrigem[smcEscala] := smcHistOrigem[smcHistOposto];
                  smcProtecaoPreco[smcEscala] := smcHistPreco[smcHistOposto];
                end;
              if (smcProtecaoConfirmacao[smcEscala] < 0) and (smcMotivoFluxo = 0) then
                smcMotivoFluxo := SMCProtecaoIncerta;

              // A proteção e os pivôs internos pertencem ao BOS qualificado.
              // Este lote ainda não inseriu os pivôs confirmados no próprio B.
              if idmCalcula and (smcEscala = 1) then
              begin
                idmLado := smcLado - 2;
                idmMotivo[idmLado] := IDMSemProtecao;
                idmBosMotivo[idmLado] := smcBarra;
                if smcProtecaoConfirmacao[1] >= 0 then
                begin
                  idmMotivo[idmLado] := IDMSemPullback;
                  idmProtecaoTicks := Round(smcProtecaoPreco[1] / smcTick);
                  idmAlvoTicks := Round(smcEventoLo[smcQuebra] / smcTick);
                  idmOrigemMin := Max(smcProtecaoOrigem[1] + 1, smcBarra - MaxBuscaPullback);
                  idmEscolhido := -1;
                  if smcHistTotal[0] >= 3 then
                    for idmHistPos := smcHistTotal[0] - 2 downto 1 do
                      if idmEscolhido < 0 then
                      begin
                        idmP := Mod(smcHistInicio[0] + idmHistPos, SMCHistPivos);
                        idmAnterior := Mod(smcHistInicio[0] + idmHistPos - 1, SMCHistPivos);
                        idmPosterior := Mod(smcHistInicio[0] + idmHistPos + 1, SMCHistPivos);
                        if (smcHistLado[idmP] = -smcDirecao) and (smcHistOrigem[idmP] >= idmOrigemMin)
                          and (smcHistOrigem[idmP] < smcBarra)
                          and (smcHistLado[idmAnterior] = smcDirecao) and (smcHistLado[idmPosterior] = smcDirecao)
                          and (smcHistOrigem[idmAnterior] < smcHistOrigem[idmP])
                          and (smcHistOrigem[idmPosterior] > smcHistOrigem[idmP])
                          and (smcHistConfirmacao[idmAnterior] < smcHistConfirmacao[idmP])
                          and (smcHistConfirmacao[idmPosterior] > smcHistConfirmacao[idmP])
                          and (smcHistConfirmacao[idmPosterior] < smcBarra)
                          and ((MinPullbackIDMATR = 0) or idmHistATRValido[idmP])
                          and ((MinReacaoIDMATR = 0) or idmHistATRValido[idmP]) then
                        begin
                          idmPrecoTicks := Round(smcHistPreco[idmP] / smcTick);
                          idmPesquisado := smcBarra - smcHistOrigem[idmP];
                          idmElegivel := ((idmPrecoTicks - idmProtecaoTicks) * smcDirecao >= MinDistProtegidoTicks)
                            and ((idmPrecoTicks - idmProtecaoTicks) * smcDirecao > ToleranciaSMCTicks)
                            and ((idmAlvoTicks - idmPrecoTicks) * smcDirecao > 0)
                            and (smcBarrasValidas >= idmPesquisado)
                            and ((Round(smcHistPreco[idmAnterior] / smcTick) - idmPrecoTicks) * smcDirecao * smcTick
                              >= Max(smcTick, MinPullbackIDMATR * idmHistATR[idmP]))
                            and ((Round(smcHistPreco[idmPosterior] / smcTick) - idmPrecoTicks) * smcDirecao * smcTick
                              >= Max(smcTick, MinReacaoIDMATR * idmHistATR[idmP]));
                          idmInc := 1;
                          while idmElegivel and (idmInc <= idmPesquisado) do
                          begin
                            idmExtremoTicks := Round(Low[idmInc] / smcTick);
                            if smcDirecao = -1 then
                              idmExtremoTicks := Round(High[idmInc] / smcTick);
                            idmElegivel := (idmExtremoTicks - idmPrecoTicks) * smcDirecao >= 0;
                            idmInc := idmInc + 1;
                          end;
                          if idmElegivel then
                            idmEscolhido := idmP;
                        end;
                      end;

                  if idmEscolhido >= 0 then
                  begin
                    idmBase := (idmLado - 1) * IDMCapacidade;
                    idmPrecoTicks := Round(smcHistPreco[idmEscolhido] / smcTick);
                    idmIDVinculo := 0;
                    idmTerminal := -1;
                    if idmVinculosTotal[idmLado] > 0 then
                      for idmVinculo := idmBase to idmBase + idmVinculosTotal[idmLado] - 1 do
                        if idmVinculoPivo[idmVinculo] = smcHistConfirmacao[idmEscolhido] then
                          idmIDVinculo := idmVinculoID[idmVinculo];
                    if idmUsados[idmLado] > 0 then
                      for idmSlot := idmBase to idmBase + idmUsados[idmLado] - 1 do
                      begin
                        if (idmIDVinculo = 0) and ((idmPivo[idmSlot] = smcHistConfirmacao[idmEscolhido])
                          or ((idmEstado[idmSlot] = IDMAtivo) and (idmNivelTicks[idmSlot] = idmPrecoTicks))) then
                          idmIDVinculo := idmID[idmSlot];
                        if idmEstado[idmSlot] <> IDMAtivo then
                        begin
                          if idmTerminal < 0 then
                            idmTerminal := idmSlot
                          else if (idmFim[idmSlot] < idmFim[idmTerminal])
                            or ((idmFim[idmSlot] = idmFim[idmTerminal]) and (idmID[idmSlot] < idmID[idmTerminal])) then
                            idmTerminal := idmSlot;
                        end;
                      end;
                    idmMotivo[idmLado] := IDMVinculado;
                    if idmIDVinculo = 0 then
                    begin
                      idmDestino := idmTerminal;
                      if idmUsados[idmLado] < IDMCapacidade then
                      begin
                        idmDestino := idmBase + idmUsados[idmLado];
                        idmUsados[idmLado] := idmUsados[idmLado] + 1;
                      end;
                      idmMotivo[idmLado] := SMCCapacityFull;
                      if idmDestino >= 0 then
                      begin
                        idmIDTotal := idmIDTotal + 1;
                        idmID[idmDestino] := idmIDTotal;
                        idmEstado[idmDestino] := IDMAtivo;
                        idmOrigem[idmDestino] := smcHistOrigem[idmEscolhido];
                        idmPivo[idmDestino] := smcHistConfirmacao[idmEscolhido];
                        idmNivelTicks[idmDestino] := idmPrecoTicks;
                        idmNivel[idmDestino] := idmPrecoTicks * smcTick;
                        idmProtecaoOrigem[idmDestino] := smcProtecaoOrigem[1];
                        idmProtecaoRef[idmDestino] := smcProtecaoConfirmacao[1];
                        idmNivelProtegidoTicks[idmDestino] := idmProtecaoTicks;
                        idmAlvoRef[idmDestino] := smcEventoRef[smcQuebra];
                        idmBosRef[idmDestino] := smcEventoNascimento[smcQuebra];
                        idmATR[idmDestino] := idmHistATR[idmEscolhido];
                        idmATRValido[idmDestino] := idmHistATRValido[idmEscolhido];
                        idmAtivacao[idmDestino] := smcBarra;
                        idmPublicacao[idmDestino] := CurrentBar;
                        idmData[idmDestino] := smcDataConfirmada;
                        idmHora[idmDestino] := smcHoraConfirmada;
                        idmFim[idmDestino] := -1;
                        idmDiaFim[idmDestino] := 0;
                        idmHoraFim[idmDestino] := 0;
                        idmIDVinculo := idmIDTotal;
                        idmMotivo[idmLado] := IDMAtivo;

                        if PoliticaNovoBOS = 0 then
                          for idmSlot := idmBase to idmBase + idmUsados[idmLado] - 1 do
                            if (idmSlot <> idmDestino) and (idmEstado[idmSlot] = IDMAtivo) then
                            begin
                              idmEstado[idmSlot] := IDMSubstituido;
                              idmFim[idmSlot] := smcBarra;
                              idmDiaFim[idmSlot] := smcDataConfirmada;
                              idmHoraFim[idmSlot] := smcHoraConfirmada;
                            end;
                      end;
                    end;

                    if idmIDVinculo > 0 then
                    begin
                      idmVinculo := idmBase + idmVinculosProximo[idmLado];
                      idmVinculoID[idmVinculo] := idmIDVinculo;
                      idmVinculoPivo[idmVinculo] := smcHistConfirmacao[idmEscolhido];
                      idmVinculoBos[idmVinculo] := smcEventoNascimento[smcQuebra];
                      idmVinculoQualificacao[idmVinculo] := smcBarra;
                      idmVinculosProximo[idmLado] := Mod(idmVinculosProximo[idmLado] + 1, IDMCapacidade);
                      idmVinculosTotal[idmLado] := Min(IDMCapacidade, idmVinculosTotal[idmLado] + 1);
                    end;
                  end;
                end;
              end;
            end;
            if flipCalcula and (smcAlvo >= 0) and (smcHistOposto >= 0) then
              if smcHistOrigem[smcHistOposto] > smcQuebraOrigem then
              begin
                flipAlvoContinuacao[smcLado] := smcQuebraOrigem;
                if (smcEventoBrutoLo[smcQuebra] <> -smcDirecao) or smcMudaFluxo then
                  flipCorrecaoContinuacao[smcLado] := smcHistOrigem[smcHistOposto];
              end;
          end;
        end;
        if flipCalcula then
        begin
          flipFluxoAnterior[smcEscala] := smcAntigoFluxo;
          flipPerdaProtecao[smcEscala] := 0;
          flipPivoAmbiguo[smcEscala] := False;
          if smcMotivoFluxo = SMCPerdaProtecao then
            flipPerdaProtecao[smcEscala] := -smcAntigoFluxo;
        end;
        // O snapshot sempre pertence ao fechamento, inclusive se continuar neutro.
        smcUltimo := smcUltimo + 1;
        smcEventoFaixa[smcUltimo] := 18 + smcEscala;
        smcEventoNascimento[smcUltimo] := smcBarra;
        smcEventoRef[smcUltimo] := smcProtecaoConfirmacao[smcEscala];
        smcEventoOrigem[smcUltimo] := -1;
        smcEventoLo[smcUltimo] := 0;
        smcEventoHi[smcUltimo] := 0;
        if smcProtecaoConfirmacao[smcEscala] >= 0 then
        begin
          smcEventoOrigem[smcUltimo] := smcProtecaoOrigem[smcEscala];
          smcEventoLo[smcUltimo] := smcProtecaoPreco[smcEscala];
        end;
        if (smcFluxo[smcEscala] = SMCTransicao) and smcTemExtremoTransicao[smcEscala] then
          smcEventoHi[smcUltimo] := smcExtremoTransicao[smcEscala];
        smcEventoBrutoLo[smcUltimo] := smcAntigoFluxo;
        smcEventoBrutoHi[smcUltimo] := smcFluxo[smcEscala];
        smcEventoEstado[smcUltimo] := SMCFato;
        smcEventoQualificacao[smcUltimo] := smcMotivoFluxo;
        smcEventoBarraQualificacao[smcUltimo] := smcBarra;
      end;

      // A camada auxiliar retém apenas o extremo mais forte de uma sequência
      // do mesmo lado. Os registros completos dos pivôs legados não mudam.
      for smcLado := 1 to 4 do
        if smcPivoNaBarra[smcLado] >= 0 then
        begin
          smcSlot := smcPivoNaBarra[smcLado];
          smcPivoConfirmado[smcLado] := smcBarra;
          smcPivoValido[smcLado] := smcBarrasValidas >= CurrentBar - smcEventoOrigem[smcSlot];
          if not smcPivoValido[smcLado] then
            smcEventoQualificacao[smcSlot] := SMCDadosInvalidos
          else
          begin
            smcDirecao := 1;
            smcEscala := 0;
            if Mod(smcLado, 2) = 0 then
              smcDirecao := -1;
            if smcLado > 2 then
              smcEscala := 1;
            smcHistBase := smcEscala * SMCHistPivos;
            smcHistQtd := smcHistTotal[smcEscala];
            smcOrigem := smcEventoOrigem[smcSlot];
            smcNivelTicks := Round(smcEventoLo[smcSlot] / smcTick);
            smcRegistraPivo := True;
            smcHistUltimo := -1;
            smcHistPos := smcHistBase + Mod(smcHistInicio[smcEscala] + smcHistQtd, SMCHistPivos);
            if smcHistQtd > 0 then
            begin
              smcHistUltimo := smcHistBase + Mod(smcHistInicio[smcEscala] + smcHistQtd - 1, SMCHistPivos);
              if (smcOrigem < smcHistOrigem[smcHistUltimo]) or
                ((smcOrigem = smcHistOrigem[smcHistUltimo]) and (smcHistLado[smcHistUltimo] <> smcDirecao)) then
              begin
                smcRegistraPivo := False;
                smcEventoQualificacao[smcSlot] := SMCAmbiguo;
                if smcOrigem = smcHistOrigem[smcHistUltimo] then
                begin
                  smcHistTotal[smcEscala] := smcHistQtd - 1;
                  if flipCalcula then
                    flipPivoAmbiguo[smcEscala] := True;
                end;
              end
              else if smcHistLado[smcHistUltimo] = smcDirecao then
              begin
                smcHistPos := smcHistUltimo;
                smcRegistraPivo := (smcNivelTicks - Round(smcHistPreco[smcHistUltimo] / smcTick)) * smcDirecao >= 0;
              end;
            end;
            if smcRegistraPivo then
            begin
              smcHistSegundo := -1;
              if smcHistPos = smcHistUltimo then
              begin
                if smcHistQtd >= 3 then
                  smcHistSegundo := smcHistBase + Mod(smcHistInicio[smcEscala] + smcHistQtd - 3, SMCHistPivos);
              end
              else if smcHistQtd >= 2 then
                smcHistSegundo := smcHistBase + Mod(smcHistInicio[smcEscala] + smcHistQtd - 2, SMCHistPivos);
              if smcHistSegundo >= 0 then
              begin
                smcDistanciaTicks := smcNivelTicks - Round(smcHistPreco[smcHistSegundo] / smcTick);
                smcEventoQualificacao[smcSlot] := SMCIgual;
                if smcDistanciaTicks > ToleranciaSMCTicks then
                begin
                  if smcDirecao = 1 then
                    smcEventoQualificacao[smcSlot] := SMCHH
                  else
                    smcEventoQualificacao[smcSlot] := SMCHL;
                end
                else if smcDistanciaTicks < -ToleranciaSMCTicks then
                begin
                  if smcDirecao = 1 then
                    smcEventoQualificacao[smcSlot] := SMCLH
                  else
                    smcEventoQualificacao[smcSlot] := SMCLL;
                end;
              end;
              smcHistOrigem[smcHistPos] := smcOrigem;
              smcHistConfirmacao[smcHistPos] := smcBarra;
              smcHistLado[smcHistPos] := smcDirecao;
              smcHistPreco[smcHistPos] := smcEventoLo[smcSlot];
              if idmCalcula and (smcEscala = 0) then
              begin
                idmHistATR[smcHistPos] := smcATR;
                idmHistATRValido[smcHistPos] := smcATRDisponivel;
              end;
              if flipCalcula then
                flipPivoAdmitido[smcLado] := smcHistPos;
              if smcHistPos <> smcHistUltimo then
              begin
                if smcHistQtd < SMCHistPivos then
                  smcHistTotal[smcEscala] := smcHistQtd + 1
                else
                  smcHistInicio[smcEscala] := Mod(smcHistInicio[smcEscala] + 1, SMCHistPivos);
              end;
            end;
          end;
        end;

      // Particoes por familia, escala e lado. A identidade de um OB/FVG e
      // preservada na saida; o lote tambem guarda o fato de remocao de t.
      smcLotes[smcQuadro] := smcUltimo - smcPrimeiro + 1;
      smcMaiorLote := Max(smcMaiorLote, smcLotes[smcQuadro]);
      for smcIndice := smcPrimeiro to smcUltimo do
      begin
        smcEventoConfirmacao[smcIndice] := smcBarra;
        smcEventoPublicacao[smcIndice] := CurrentBar;
        smcEventoData[smcIndice] := smcDataConfirmada;
        smcEventoHora[smcIndice] := smcHoraConfirmada;
        smcEventoATR[smcIndice] := smcATR;
        smcEventoATRValido[smcIndice] := smcATRDisponivel;
        smcEventoDataOrigem[smcIndice] := 0;
        smcEventoHoraOrigem[smcIndice] := 0;
        smcEventoTerminal[smcIndice] := -1;
        smcEventoDataTerminal[smcIndice] := 0;
        smcEventoHoraTerminal[smcIndice] := 0;
        if smcEventoEstado[smcIndice] <> SMCAtivo then
        begin
          smcEventoTerminal[smcIndice] := smcBarra;
          smcEventoDataTerminal[smcIndice] := smcDataConfirmada;
          smcEventoHoraTerminal[smcIndice] := smcHoraConfirmada;
        end;
        if smcEventoOrigem[smcIndice] >= 0 then
        begin
          smcDeslocamento := CurrentBar - smcEventoOrigem[smcIndice];
          smcEventoDataOrigem[smcIndice] := dataCandle[smcDeslocamento];
          smcEventoHoraOrigem[smcIndice] := horaCandle[smcDeslocamento];
        end;

        smcFaixa := smcEventoFaixa[smcIndice];
        smcEventoDadosValidos[smcIndice] := smcBarraValida;
        if smcFaixa <= 8 then
          smcEventoDadosValidos[smcIndice] := smcBarraValida
            and (smcEventoQualificacao[smcIndice] <> SMCDadosInvalidos)
        else if (smcFaixa <= 16) and (smcEventoNascimento[smcIndice] = smcBarra)
          and (smcEventoRef[smcIndice] >= 0) then
          smcEventoDadosValidos[smcIndice] := smcBarrasValidas >= CurrentBar - smcEventoRef[smcIndice];
        smcInicioFaixa := SMCBaseHistorico + (smcFaixa - 1) * SMCCapacidade;
        smcFimFaixa := smcInicioFaixa + smcUsados[smcFaixa] - 1;
        smcAchado := -1;
        smcTerminal := -1;
        if (smcFaixa >= 18) and (smcUsados[smcFaixa] = SMCCapacidade) then
          smcTerminal := smcInicioFaixa + Mod(smcBarra, SMCCapacidade)
        else if (smcFimFaixa >= smcInicioFaixa) and ((smcUsados[smcFaixa] = SMCCapacidade)
          or (smcEventoEstado[smcIndice] = SMCMitigado) or (smcEventoEstado[smcIndice] = SMCDescarte)) then
          for smcDestino := smcInicioFaixa to smcFimFaixa do
          begin
            if (smcFaixa >= 9) and (smcFaixa <= 14)
              and ((smcEventoEstado[smcIndice] = SMCMitigado) or (smcEventoEstado[smcIndice] = SMCDescarte))
              and (smcEventoNascimento[smcDestino] = smcEventoNascimento[smcIndice]) then
              smcAchado := smcDestino;
            if (smcUsados[smcFaixa] = SMCCapacidade)
              and (smcEventoEstado[smcDestino] <> SMCAtivo)
              and (smcEventoQualificacao[smcDestino] <> SMCAguardando) then
            begin
              if smcTerminal < 0 then
                smcTerminal := smcDestino
              else if (Max(smcEventoTerminal[smcDestino], smcEventoBarraQualificacao[smcDestino])
                  < Max(smcEventoTerminal[smcTerminal], smcEventoBarraQualificacao[smcTerminal]))
                or ((Max(smcEventoTerminal[smcDestino], smcEventoBarraQualificacao[smcDestino])
                    = Max(smcEventoTerminal[smcTerminal], smcEventoBarraQualificacao[smcTerminal]))
                  and (smcEventoNascimento[smcDestino] < smcEventoNascimento[smcTerminal])) then
                smcTerminal := smcDestino;
            end;
          end;

        if smcAchado >= 0 then
        begin
          smcEventoEstado[smcAchado] := smcEventoEstado[smcIndice];
          smcEventoTerminal[smcAchado] := smcBarra;
          smcEventoDataTerminal[smcAchado] := smcDataConfirmada;
          smcEventoHoraTerminal[smcAchado] := smcHoraConfirmada;
        end
        else
        begin
          smcDestino := smcTerminal;
          if smcUsados[smcFaixa] < SMCCapacidade then
          begin
            smcDestino := smcFimFaixa + 1;
            smcUsados[smcFaixa] := smcUsados[smcFaixa] + 1;
          end
          else if smcDestino >= 0 then
            smcReciclados := smcReciclados + 1;

          if smcDestino >= 0 then
          begin
              smcEventoFaixa[smcDestino] := smcEventoFaixa[smcIndice];
              smcEventoOrigem[smcDestino] := smcEventoOrigem[smcIndice];
              smcEventoRef[smcDestino] := smcEventoRef[smcIndice];
              smcEventoNascimento[smcDestino] := smcEventoNascimento[smcIndice];
              smcEventoEstado[smcDestino] := smcEventoEstado[smcIndice];
              smcEventoConfirmacao[smcDestino] := smcEventoConfirmacao[smcIndice];
              smcEventoPublicacao[smcDestino] := smcEventoPublicacao[smcIndice];
              smcEventoData[smcDestino] := smcEventoData[smcIndice];
              smcEventoHora[smcDestino] := smcEventoHora[smcIndice];
              smcEventoDataOrigem[smcDestino] := smcEventoDataOrigem[smcIndice];
              smcEventoHoraOrigem[smcDestino] := smcEventoHoraOrigem[smcIndice];
              smcEventoTerminal[smcDestino] := smcEventoTerminal[smcIndice];
              smcEventoDataTerminal[smcDestino] := smcEventoDataTerminal[smcIndice];
              smcEventoHoraTerminal[smcDestino] := smcEventoHoraTerminal[smcIndice];
              smcEventoQualificacao[smcDestino] := smcEventoQualificacao[smcIndice];
              smcEventoBarraQualificacao[smcDestino] := smcEventoBarraQualificacao[smcIndice];
              smcEventoLo[smcDestino] := smcEventoLo[smcIndice];
              smcEventoHi[smcDestino] := smcEventoHi[smcIndice];
              smcEventoBrutoLo[smcDestino] := smcEventoBrutoLo[smcIndice];
              smcEventoBrutoHi[smcDestino] := smcEventoBrutoHi[smcIndice];
              smcEventoATR[smcDestino] := smcEventoATR[smcIndice];
              smcEventoATRValido[smcDestino] := smcEventoATRValido[smcIndice];
              smcEventoDadosValidos[smcDestino] := smcEventoDadosValidos[smcIndice];
          end
          else
          begin
            smcEventoQualificacao[smcIndice] := SMCCapacityFull;
            smcRejeitadosCapacidade := smcRejeitadosCapacidade + 1;
          end;
          if (smcFaixa >= 5) and (smcFaixa <= 8) then
          begin
            smcLado := smcFaixa - 4;
            if smcEspera[smcLado] = smcIndice then
              smcEspera[smcLado] := smcDestino;
          end;
        end;
        smcPublicados := smcPublicados + 1;
      end;

      // 09A: avaliar o nivel congelado antes de consumir os pivos deste lote.
      if flipCalcula then
        for flipLado := 1 to 4 do
        begin
          flipEscala := 0;
          if flipLado > 2 then
            flipEscala := 1;
          if (EscalaFlip = 2) or (EscalaFlip = flipEscala) then
          begin
            flipDirecao := 1;
            flipReacaoLado := flipLado + 1;
            if Mod(flipLado, 2) = 0 then
            begin
              flipDirecao := -1;
              flipReacaoLado := flipLado - 1;
            end;
            flipBase := (flipLado - 1) * FlipCapacidade;

            // Estados posteriores nao alteram os pivos nem a geometria do Flip.
            flipTerminal := -1;
            if flipUsados[flipLado] > 0 then
              for flipIndice := flipBase to flipBase + flipUsados[flipLado] - 1 do
              begin
                if smcBarraValida and (flipEventoFalha[flipIndice] < 0) then
                begin
                  flipExtremoTicks := Round(flipEventoExtremoPreco[flipIndice] / smcTick);
                  if (smcFechamentoTicks - flipExtremoTicks) * flipDirecao < 0 then
                    flipEventoFalha[flipIndice] := smcBarra
                  else if (flipEventoContinuacao[flipIndice] < 0)
                    and (flipAlvoContinuacao[flipLado] > flipEventoConfirmacao[flipIndice]) then
                    flipEventoContinuacao[flipIndice] := smcBarra;
                  if MostrarContinuationFlip and (flipEventoQualEstado[flipIndice] = FlipQualConfirmada)
                    and (flipEventoContinuationID[flipIndice] = 0)
                    and (flipAlvoContinuacao[flipLado] > flipEventoQualBarra[flipIndice])
                    and (flipCorrecaoContinuacao[flipLado] > flipEventoQualBarra[flipIndice])
                    and (flipEventoFalha[flipIndice] < 0) then
                  begin
                    if flipContinuacaoSlot[flipLado] < 0 then
                      flipContinuacaoSlot[flipLado] := flipIndice
                    else if flipEventoConfirmacao[flipIndice] > flipEventoConfirmacao[flipContinuacaoSlot[flipLado]] then
                      flipContinuacaoSlot[flipLado] := flipIndice;
                  end;
                end;
                if flipEventoFalha[flipIndice] >= 0 then
                begin
                  if flipTerminal < 0 then
                    flipTerminal := flipIndice
                  else if (flipEventoFalha[flipIndice] < flipEventoFalha[flipTerminal])
                    or ((flipEventoFalha[flipIndice] = flipEventoFalha[flipTerminal])
                    and (flipEventoConfirmacao[flipIndice] < flipEventoConfirmacao[flipTerminal])) then
                    flipTerminal := flipIndice;
                end;
              end;

            flipConfirmar := False;
            if flipFase[flipLado] <> 0 then
            begin
              flipSaida := 0;
              if not smcBarraValida then
                flipSaida := FlipDadosInvalidos
              else if flipPivoAmbiguo[flipEscala] then
                flipSaida := FlipOrdemAmbigua
              else if (MaxBarrasFlip > 0) and (smcBarra - flipMeioRef[flipLado] > MaxBarrasFlip) then
                flipSaida := FlipPrazoExcedido
              else
              begin
                flipMeioTicks := Round(flipMeioPreco[flipLado] / smcTick);
                flipExtremoTicks := Round(flipExtremoPreco[flipLado] / smcTick);
                flipDistancia := (smcFechamentoTicks - flipMeioTicks) * flipDirecao;
                if (Round(High[1] / smcTick) > Max(flipMeioTicks, flipExtremoTicks))
                  and (Round(Low[1] / smcTick) < Min(flipMeioTicks, flipExtremoTicks)) then
                  flipSaida := FlipOrdemAmbigua
                else if (smcFechamentoTicks - flipExtremoTicks) * flipDirecao < 0 then
                  flipSaida := FlipExtremoRompido
                else if flipFase[flipLado] = FlipAguardaReacao then
                begin
                  if flipDistancia > 0 then
                    flipSaida := FlipPerdaPrecoce;
                end
                else if flipCruzaEm[flipLado] >= 0 then
                begin
                  if flipDistancia <= 0 then
                    flipSaida := FlipRetornouNivel
                  else if flipDistancia >= BufferRupturaSMCTicks then
                    flipConfirmar := True;
                end
                else if smcTemAnterior and (flipDistancia > 0) then
                begin
                  flipDistanciaAnterior := (smcAnteriorTicks - flipMeioTicks) * flipDirecao;
                  if flipDistanciaAnterior <= 0 then
                  begin
                    flipGap := ((flipDirecao = 1) and (Round(Low[1] / smcTick) > flipMeioTicks))
                      or ((flipDirecao = -1) and (Round(High[1] / smcTick) < flipMeioTicks));
                    if flipGap and (not PermitirGapFlip) then
                      flipSaida := FlipGapBloqueado
                    else
                    begin
                      flipCruzaEm[flipLado] := smcBarra;
                      flipConfirmar := flipDistancia >= BufferRupturaSMCTicks;
                    end;
                  end;
                end;
              end;

              if (flipSaida = 0) and (flipCruzaEm[flipLado] >= 0) and (flipLegadoEm[flipLado] < 0) then
              begin
                flipQuebraLegada := smcBreakNaBarra[flipLado];
                if flipQuebraLegada >= 0 then
                  if smcEventoRef[flipQuebraLegada] = flipMeioRef[flipLado] then
                  begin
                    flipLegadoEm[flipLado] := smcBarra;
                    flipLegadoTipo[flipLado] := 1;
                    if smcEventoBrutoLo[flipQuebraLegada] = -flipDirecao then
                      flipLegadoTipo[flipLado] := 2;
                  end;
              end;

              if flipConfirmar then
              begin
                flipDestino := flipTerminal;
                if flipUsados[flipLado] < FlipCapacidade then
                begin
                  flipDestino := flipBase + flipUsados[flipLado];
                  flipUsados[flipLado] := flipUsados[flipLado] + 1;
                end;
                flipSaida := FlipSemVaga;
                if flipDestino < 0 then
                  flipSemVagaTotal := flipSemVagaTotal + 1
                else
                begin
                  flipEventoExtremo[flipDestino] := flipExtremoRef[flipLado];
                  flipEventoMeio[flipDestino] := flipMeioRef[flipLado];
                  flipEventoReacao[flipDestino] := flipReacaoRef[flipLado];
                  flipEventoOrigemExtremo[flipDestino] := flipExtremoOrigem[flipLado];
                  flipEventoOrigemMeio[flipDestino] := flipMeioOrigem[flipLado];
                  flipEventoOrigemReacao[flipDestino] := flipReacaoOrigem[flipLado];
                  flipEventoCruzamento[flipDestino] := flipCruzaEm[flipLado];
                  flipEventoConfirmacao[flipDestino] := smcBarra;
                  flipEventoPublicacao[flipDestino] := CurrentBar;
                  flipEventoData[flipDestino] := smcDataConfirmada;
                  flipEventoHora[flipDestino] := smcHoraConfirmada;
                  flipEventoDataMeio[flipDestino] := flipMeioDia[flipLado];
                  flipEventoHoraMeio[flipDestino] := flipMeioHora[flipLado];
                  flipEventoContexto[flipDestino] := 0;
                  if (flipEscala = 0) and (Abs(flipFluxoAnterior[1]) = 1) then
                    flipEventoContexto[flipDestino] := flipFluxoAnterior[1] * flipDirecao;
                  flipEventoReversao[flipDestino] := (flipEscala = 1) and (flipPerdaProtecao[1] = flipDirecao);
                  flipEventoLegado[flipDestino] := flipLegadoEm[flipLado];
                  flipEventoTipoLegado[flipDestino] := flipLegadoTipo[flipLado];
                  flipEventoContinuacao[flipDestino] := -1;
                  flipEventoFalha[flipDestino] := -1;
                  flipEventoNivel[flipDestino] := flipMeioPreco[flipLado];
                  flipEventoExtremoPreco[flipDestino] := flipExtremoPreco[flipLado];
                  flipEventoReacaoPreco[flipDestino] := flipReacaoPreco[flipLado];
                  flipEventoATRMeio[flipDestino] := flipATRMeio[flipLado];
                  flipEventoModoFalha[flipDestino] := flipFalhaTipo[flipLado];
                  if flipContinuacaoSlot[flipLado] = flipDestino then
                    flipContinuacaoSlot[flipLado] := -1;
                  flipEventoZonaID[flipDestino] := 0;
                  flipEventoZonaMotivo[flipDestino] := 0;
                  flipEventoExtremeID[flipDestino] := 0;
                  flipEventoExtremeMotivo[flipDestino] := 0;
                  flipEventoContinuationID[flipDestino] := 0;
                  flipEventoContinuationMotivo[flipDestino] := 0;
                  flipPublicadoSlot[flipLado] := flipDestino;
                  flipTotal := flipTotal + 1;
                  flipSaida := FlipConfirmado;
                end;
              end;

              if flipSaida <> 0 then
              begin
                flipFase[flipLado] := 0;
                flipMotivo[flipLado] := flipSaida;
                flipBarraMotivo[flipLado] := smcBarra;
              end;
            end;

            if smcBarraValida and (not flipPivoAmbiguo[flipEscala]) and (flipFase[flipLado] <> FlipArmado) then
            begin
              flipNovoPivo := flipPivoAdmitido[flipLado];
              if (flipNovoPivo >= 0) and (smcHistTotal[flipEscala] >= 2) then
              begin
                // L1/H1 acabou de entrar no historico; o pivo anterior e H0/L0.
                flipFase[flipLado] := 0;
                if flipFluxoAnterior[flipEscala] = -flipDirecao then
                begin
                  flipPivoAnterior := flipEscala * SMCHistPivos
                    + Mod(smcHistInicio[flipEscala] + smcHistTotal[flipEscala] - 2, SMCHistPivos);
                  flipBarraMotivo[flipLado] := smcBarra;
                  if (ReacaoMinFlipATR > 0) and (not smcATRDisponivel) then
                    flipMotivo[flipLado] := FlipATRIndisponivel
                  else if (smcFechamentoTicks - Round(smcHistPreco[flipNovoPivo] / smcTick)) * flipDirecao > 0 then
                    flipMotivo[flipLado] := FlipPerdaPrecoce
                  else if (smcHistLado[flipPivoAnterior] = -flipDirecao)
                    and (smcHistOrigem[flipPivoAnterior] < smcHistOrigem[flipNovoPivo]) then
                  begin
                    flipExtremoRef[flipLado] := smcHistConfirmacao[flipPivoAnterior];
                    flipExtremoOrigem[flipLado] := smcHistOrigem[flipPivoAnterior];
                    flipExtremoPreco[flipLado] := smcHistPreco[flipPivoAnterior];
                    flipMeioRef[flipLado] := smcBarra;
                    flipMeioOrigem[flipLado] := smcHistOrigem[flipNovoPivo];
                    flipMeioPreco[flipLado] := smcHistPreco[flipNovoPivo];
                    flipMeioDia[flipLado] := smcDataConfirmada;
                    flipMeioHora[flipLado] := smcHoraConfirmada;
                    flipATRMeio[flipLado] := smcATR;
                    flipCruzaEm[flipLado] := -1;
                    flipLegadoEm[flipLado] := -1;
                    flipLegadoTipo[flipLado] := 0;
                    flipFase[flipLado] := FlipAguardaReacao;
                    flipMotivo[flipLado] := FlipAguardaReacao;
                  end;
                end;
              end
              else if flipFase[flipLado] = FlipAguardaReacao then
              begin
                flipNovoPivo := flipPivoAdmitido[flipReacaoLado];
                if (flipNovoPivo >= 0) and (smcHistTotal[flipEscala] >= 2) then
                begin
                  flipPivoAnterior := flipEscala * SMCHistPivos
                    + Mod(smcHistInicio[flipEscala] + smcHistTotal[flipEscala] - 2, SMCHistPivos);
                  if smcHistConfirmacao[flipPivoAnterior] = flipMeioRef[flipLado] then
                  begin
                    flipDistancia := (Round(smcHistPreco[flipNovoPivo] / smcTick)
                      - Round(flipExtremoPreco[flipLado] / smcTick)) * flipDirecao;
                    flipMinimo := Max(smcTick, ReacaoMinFlipATR * flipATRMeio[flipLado]);
                    flipBarraMotivo[flipLado] := smcBarra;
                    flipFalhaTipo[flipLado] := 0;
                    flipVarredura := False;
                    if (ModoFalhaFlip >= 1) and (Abs(flipDistancia) <= ToleranciaSMCTicks) then
                      flipFalhaTipo[flipLado] := 1;
                    if (ModoFalhaFlip = 2) and (flipDistancia <= -1) then
                    begin
                      flipQualInc := CurrentBar - smcHistOrigem[flipNovoPivo];
                      flipQualExtremo := Round(flipExtremoPreco[flipLado] / smcTick);
                      if (flipQualInc >= 1) and (smcBarrasValidas >= flipQualInc) then
                        flipVarredura := ((Round(Close[flipQualInc] / smcTick) - flipQualExtremo) * flipDirecao >= 0)
                          and (Round(Low[flipQualInc] / smcTick) <= flipQualExtremo)
                          and (Round(High[flipQualInc] / smcTick) >= flipQualExtremo)
                          and (((flipDirecao = -1) and (Round(High[flipQualInc] / smcTick) > flipQualExtremo))
                            or ((flipDirecao = 1) and (Round(Low[flipQualInc] / smcTick) < flipQualExtremo)));
                      if flipVarredura then
                        flipFalhaTipo[flipLado] := 2;
                    end;
                    if (flipDistancia <= ToleranciaSMCTicks) and (flipFalhaTipo[flipLado] = 0) then
                      flipMotivo[flipLado] := FlipForaTolerancia
                    else if Abs(Round(smcHistPreco[flipNovoPivo] / smcTick)
                      - Round(flipMeioPreco[flipLado] / smcTick)) * smcTick < flipMinimo then
                      flipMotivo[flipLado] := FlipSemReacao
                    else if (Round(flipMeioPreco[flipLado] / smcTick)
                      - Round(smcHistPreco[flipNovoPivo] / smcTick)) * flipDirecao > 0 then
                    begin
                      flipReacaoRef[flipLado] := smcBarra;
                      flipReacaoOrigem[flipLado] := smcHistOrigem[flipNovoPivo];
                      flipReacaoPreco[flipLado] := smcHistPreco[flipNovoPivo];
                      flipFase[flipLado] := FlipArmado;
                      flipMotivo[flipLado] := FlipArmado;
                    end;
                  end;
                end;
              end;
            end;
          end;
        end;
      // Qualificar uma quebra sem reescrever B. Só a qualificação publica o Flip.
      if flipCalcula then
      begin
        if flipDetectaFVG and (smcBarrasValidas >= 3) and (ladoNovoFVG[1] <> 0) then
        begin
          flipQualFVG := 1;
          if ladoNovoFVG[1] = -1 then
            flipQualFVG := 2;
          flipQualFVGBarra[flipQualFVG] := smcBarra;
          flipQualFVGMeio[flipQualFVG] := smcBarra - 1;
        end;

        for flipQualLado := 1 to 4 do
        begin
          flipQualNovo := flipPublicadoSlot[flipQualLado];
          flipQualEspera := flipQualPendenteSlot[flipQualLado];
          flipQualDir := 1;
          flipQualFVG := 1;
          if Mod(flipQualLado, 2) = 0 then
          begin
            flipQualDir := -1;
            flipQualFVG := 2;
          end;

          if flipQualNovo >= 0 then
          begin
            if (flipQualEspera >= 0) and (flipQualEspera <> flipQualNovo) then
              flipEventoQualEstado[flipQualEspera] := FlipQualCancelada;
            if flipUltimaFib[flipQualLado] = flipQualNovo then
              flipUltimaFib[flipQualLado] := -1;
            flipQualEspera := flipQualNovo;
            flipEventoQualEstado[flipQualNovo] := FlipQualPendente;
            flipEventoQualBarra[flipQualNovo] := -1;
            flipEventoQualPublicacao[flipQualNovo] := -1;
            flipEventoFVGEm[flipQualNovo] := -1;
            flipEventoDispEm[flipQualNovo] := -1;
            flipEventoDispInicio[flipQualNovo] := -1;
            flipEventoVolumeEm[flipQualNovo] := -1;
            flipEventoNota[flipQualNovo] := 0;
            flipEventoFibLo[flipQualNovo] := 0;
            flipEventoFibHi[flipQualNovo] := 0;

            if flipUsaFib and flipAvancadoValido then
            begin
              flipQualPerna := flipEventoOrigemReacao[flipQualNovo];
              flipQualLimite := CurrentBar - flipQualPerna;
              if (flipQualLimite >= 1) and (smcBarrasValidas >= flipQualLimite) then
              begin
                flipQualLo := Low[1];
                flipQualHi := High[1];
                for flipQualInc := 2 to flipQualLimite do
                begin
                  flipQualLo := Min(flipQualLo, Low[flipQualInc]);
                  flipQualHi := Max(flipQualHi, High[flipQualInc]);
                end;
                flipQualPosicao := flipEventoReacaoPreco[flipQualNovo];
                if ModoRangeFlip = 1 then
                  flipQualPosicao := flipEventoExtremoPreco[flipQualNovo];
                if flipQualDir = 1 then
                  flipQualLo := flipQualPosicao
                else
                  flipQualHi := flipQualPosicao;
                flipEventoFibLo[flipQualNovo] := flipQualLo;
                flipEventoFibHi[flipQualNovo] := flipQualHi;
              end;
            end;
          end;

          if flipQualEspera >= 0 then
          begin
            flipQualSlot := flipQualEspera;
            flipQualB := flipEventoConfirmacao[flipQualSlot];
            flipQualPerna := flipEventoOrigemReacao[flipQualSlot];
            if not flipAvancadoValido then
              flipEventoQualEstado[flipQualSlot] := FlipQualConfigInvalida
            else if not smcBarraValida then
              flipEventoQualEstado[flipQualSlot] := FlipQualCancelada
            else if flipTemFiltro and (((smcFechamentoTicks - Round(flipEventoNivel[flipQualSlot] / smcTick)) * flipQualDir <= 0)
              or (flipEventoFalha[flipQualSlot] >= 0)) then
              flipEventoQualEstado[flipQualSlot] := FlipQualCancelada
            else if smcBarra - flipQualB > MaxBarrasFVGFlip then
              flipEventoQualEstado[flipQualSlot] := FlipQualExpirada
            else
            begin
              if flipTemFiltro then
              begin
                if (FiltroFVGFlip > 0) and (flipEventoFVGEm[flipQualSlot] < 0) and (flipQualFVGBarra[flipQualFVG] >= 0)
                  and (flipQualFVGMeio[flipQualFVG] >= flipQualPerna)
                  and ((FiltroFVGFlip = 1) or (flipQualFVGBarra[flipQualFVG] >= flipQualB)) then
                  flipEventoFVGEm[flipQualSlot] := flipQualFVGBarra[flipQualFVG];

                if (FiltroDispFlip > 0) and (flipEventoDispEm[flipQualSlot] < 0)
                  and ((Close[1] - Open[1]) * flipQualDir > 0) then
                begin
                  flipQualCorpos := 0;
                  flipQualRange := 0;
                  flipQualDirecionais := 0;
                  flipQualSequenciaValida := True;
                  for flipQualK := 1 to MaxCandlesDispFlip do
                    if (flipEventoDispEm[flipQualSlot] < 0) and (flipQualK <= smcBarrasValidas)
                      and (smcBarra - flipQualK + 1 >= flipQualPerna) then
                    begin
                      flipQualCandle := High[flipQualK] - Low[flipQualK];
                      flipQualSequenciaValida := flipQualSequenciaValida and (flipQualCandle > 0);
                      flipQualCorpo := (Close[flipQualK] - Open[flipQualK]) * flipQualDir;
                      flipQualCorpos := flipQualCorpos + flipQualCorpo;
                      flipQualRange := flipQualRange + flipQualCandle;
                      if flipQualCorpo > 0 then
                        flipQualDirecionais := flipQualDirecionais + 1;
                      flipQualPosicao := (Close[1] - Low[1]) * 4;
                      if flipQualDir = -1 then
                        flipQualPosicao := (High[1] - Close[1]) * 4;
                      if flipQualSequenciaValida and (flipQualDirecionais * 2 >= flipQualK)
                        and ((DispATRFlip = 0) or poiATRValido[flipQualK])
                        and (flipQualCorpos >= Max(smcTick, DispATRFlip * poiATRBarra[flipQualK]))
                        and (flipQualCorpos >= CorpoMinFlip * flipQualRange)
                        and (flipQualPosicao >= (High[1] - Low[1]) * 3) then
                      begin
                        flipEventoDispEm[flipQualSlot] := smcBarra;
                        flipEventoDispInicio[flipQualSlot] := smcBarra - flipQualK + 1;
                      end;
                    end;
                end;

                if (FiltroVolumeFlip > 0) and (flipEventoVolumeEm[flipQualSlot] < 0)
                  and (smcBarra >= PeriodoVolumeFlip) and (Volume[1] > 0) then
                begin
                  flipQualVol := 0;
                  for flipQualInc := 2 to PeriodoVolumeFlip + 1 do
                    flipQualVol := flipQualVol + Volume[flipQualInc];
                  if (flipQualVol > 0) and (Volume[1] * PeriodoVolumeFlip >= FatorVolumeFlip * flipQualVol) then
                    flipEventoVolumeEm[flipQualSlot] := smcBarra;
                end;
              end;

              flipQualFVGOk := flipEventoFVGEm[flipQualSlot] >= 0;
              flipQualDispOk := flipEventoDispEm[flipQualSlot] >= 0;
              flipQualVolOk := flipEventoVolumeEm[flipQualSlot] >= 0;
              flipQualPode := ((FiltroFVGFlip <> 2) or flipQualFVGOk)
                and ((FiltroDispFlip <> 2) or flipQualDispOk) and ((FiltroVolumeFlip <> 2) or flipQualVolOk);
              if flipQualPode then
              begin
                flipQualNota := 0;
                if flipQualFVGOk then
                  flipQualNota := flipQualNota + 1;
                if flipQualDispOk then
                  flipQualNota := flipQualNota + 1;
                if flipQualVolOk then
                  flipQualNota := flipQualNota + 1;
                flipEventoNota[flipQualSlot] := flipQualNota;
                flipEventoQualEstado[flipQualSlot] := FlipQualConfirmada;
                flipEventoQualBarra[flipQualSlot] := smcBarra;
                flipEventoQualPublicacao[flipQualSlot] := CurrentBar;
                flipEventoQualDia[flipQualSlot] := smcDataConfirmada;
                flipEventoQualHora[flipQualSlot] := smcHoraConfirmada;
                flipQualPublicado[flipQualLado] := flipQualSlot;
                flipUltimaFib[flipQualLado] := flipQualSlot;
              end
              else if smcBarra - flipQualB >= MaxBarrasFVGFlip then
                flipEventoQualEstado[flipQualSlot] := FlipQualExpirada;
            end;
            if flipEventoQualEstado[flipQualSlot] <> FlipQualPendente then
              flipQualEspera := -1;
          end;
          flipQualPendenteSlot[flipQualLado] := flipQualEspera;
        end;
      end;

      if poiCalcula then
      begin
        for poiLado := 1 to 12 do
        begin
          poiDir := 1;
          if Mod(poiLado, 2) = 0 then
            poiDir := -1;
          poiBase := (poiLado - 1) * FlipCapacidade;
          if poiUsados[poiLado] > 0 then
            for poiSlot := poiBase to poiBase + poiUsados[poiLado] - 1 do
              if (poiFimZona[poiSlot] < 0) and smcBarraValida then
              begin
                poiLoTicks := poiLoZona[poiSlot];
                poiHiTicks := poiHiZona[poiSlot];
                poiProx := poiHiTicks;
                poiDist := poiLoTicks;
                poiPavio := Round(Low[1] / smcTick);
                poiPavioReacao := Round(High[1] / smcTick);
                if poiDir = -1 then
                begin
                  poiProx := poiLoTicks;
                  poiDist := poiHiTicks;
                  poiPavio := Round(High[1] / smcTick);
                  poiPavioReacao := Round(Low[1] / smcTick);
                end;
                poiAvanco := (smcFechamentoTicks - poiProx) * poiDir;
                poiDentro := ((poiPavio - poiProx) * poiDir <= 0)
                  and ((poiPavioReacao - poiDist) * poiDir >= 0);
                poiPivoAtual := smcFechamentoTicks;
                if ModoInvalidacaoFlip = 1 then
                  poiPivoAtual := poiPavio;
                poiInvalidou := (poiDist - poiPivoAtual) * poiDir >= Max(1, BufferInvalidacaoTicksFlip);
                poiIdadeExcedida := (MaxIdadeFlip > 0) and (smcBarra - poiAtivacao[poiSlot] > MaxIdadeFlip);
                poiEncerrou := False;
                poiTocou := False;
                if (not poiIdadeExcedida) and (poiEstado[poiSlot] = POIAguardaSaida) then
                begin
                  if poiAvanco > 0 then
                  begin
                    poiEstado[poiSlot] := POIFresh;
                    poiAproxima[poiSlot] := True;
                  end;
                end
                else if (not poiIdadeExcedida) and poiDentro then
                begin
                  poiTocou := poiVisita[poiSlot] or poiAproxima[poiSlot];
                  if poiTocou then
                  begin
                    if not poiVisita[poiSlot] then
                      poiVisitas[poiSlot] := poiVisitas[poiSlot] + 1;
                    poiVisita[poiSlot] := True;
                    poiProf := Min(1, (poiProx - poiPavio) * poiDir / (poiHiTicks - poiLoTicks));
                    poiProfundidade[poiSlot] := Max(poiProfundidade[poiSlot], poiProf);
                    poiEstado[poiSlot] := POITocada;
                    if poiProfundidade[poiSlot] >= 1 then
                      poiEstado[poiSlot] := POIMitigadaTotal
                    else if poiProfundidade[poiSlot] >= 0.5 then
                      poiEstado[poiSlot] := POIMitigada50;
                  end;
                end
                else if not poiIdadeExcedida then
                begin
                  poiEncerrou := poiVisita[poiSlot] and (MaxVisitasFlip > 0)
                    and (poiVisitas[poiSlot] >= MaxVisitasFlip);
                  poiVisita[poiSlot] := False;
                  poiPrimeiraVisita[poiSlot] := False;
                  poiAproxima[poiSlot] := (poiPavio - poiProx) * poiDir > 0;
                end;

                if poiTocou and (poiToque[poiSlot] < 0) then
                begin
                  poiToque[poiSlot] := smcBarra;
                  poiExtremo[poiSlot] := poiPavio;
                  poiPrimeiraVisita[poiSlot] := True;
                  poiATRToque[poiSlot] := smcATR;
                  poiATRToqueValido[poiSlot] := smcATRDisponivel;
                  if ModoRetesteFlip > 0 then
                    poiStatusReteste[poiSlot] := POIRetesteAguardando;
                  if ModoRetesteFlip = 2 then
                  begin
                    poiIndicePivo := 1;
                    if poiDir = -1 then
                      poiIndicePivo := 2;
                    if poiPivoDisponivel[poiIndicePivo] and smcTemAnterior
                      and ((smcFechamentoTicks - poiPivoNivel[poiIndicePivo]) * poiDir <= 0) then
                    begin
                      poiAlvo[poiSlot] := poiPivoNivel[poiIndicePivo];
                      poiAlvoRef[poiSlot] := poiPivoConfirmado[poiIndicePivo];
                    end;
                  end;
                  if ((ModoRetesteFlip > 0) and (ReacaoRetesteATRFlip > 0) and (not smcATRDisponivel))
                    or ((ModoRetesteFlip = 2) and (poiAlvoRef[poiSlot] < 0)) then
                    poiStatusReteste[poiSlot] := POIRetesteIndisponivel;
                end;

                if poiInvalidou then
                begin
                  poiEstado[poiSlot] := POIInvalidada;
                  poiIntersecaoInvalidacao[poiSlot] := poiDentro;
                end
                else if poiEncerrou or poiIdadeExcedida then
                  poiEstado[poiSlot] := POIExpirada
                else
                begin
                  if (poiStatusReteste[poiSlot] = POIRetesteAguardando)
                    and (smcBarra - poiToque[poiSlot] > MaxBarrasRetesteFlip) then
                    poiStatusReteste[poiSlot] := POIRetesteExpirado;
                  if (poiStatusReteste[poiSlot] = POIRetesteAguardando) and (smcBarra > poiToque[poiSlot]) then
                  begin
                    if (ModoRetesteFlip = 2) and (poiAlvoRef[poiSlot] >= 0) and (not poiAlvoRompido[poiSlot]) then
                    begin
                      poiAvanco := (smcFechamentoTicks - poiAlvo[poiSlot]) * poiDir;
                      if (poiAvanco <= 0) or (not smcTemAnterior) then
                        poiCruzouAlvo[poiSlot] := False
                      else
                      begin
                        if (smcAnteriorTicks - poiAlvo[poiSlot]) * poiDir <= 0 then
                          poiCruzouAlvo[poiSlot] := True;
                        if poiCruzouAlvo[poiSlot] and (poiAvanco >= Max(1, BufferRupturaSMCTicks)) then
                          poiAlvoRompido[poiSlot] := True;
                      end;
                    end;
                    poiReagiu := ((ReacaoRetesteATRFlip = 0) or poiATRToqueValido[poiSlot])
                      and ((poiPavioReacao - poiExtremo[poiSlot]) * poiDir * smcTick
                        >= Max(smcTick, ReacaoRetesteATRFlip * poiATRToque[poiSlot]))
                      and ((smcFechamentoTicks - poiProx) * poiDir > 0);
                    if poiReagiu and ((ModoRetesteFlip = 1) or poiAlvoRompido[poiSlot]) then
                    begin
                      poiReteste[poiSlot] := smcBarra;
                      poiStatusReteste[poiSlot] := POIRetesteConfirmado;
                    end;
                  end;
                  if (EncerrarAposMitigacaoFlip > 0) and (poiProfundidade[poiSlot] * 100 >= EncerrarAposMitigacaoFlip) then
                    poiEstado[poiSlot] := POIEncerrada;
                end;
                if poiTocou and poiPrimeiraVisita[poiSlot] and ((poiPavio - poiExtremo[poiSlot]) * poiDir < 0) then
                  poiExtremo[poiSlot] := poiPavio;
                if poiEstado[poiSlot] >= POIInvalidada then
                begin
                  if poiStatusReteste[poiSlot] = POIRetesteAguardando then
                    poiStatusReteste[poiSlot] := POIRetesteEncerrado;
                  poiFimZona[poiSlot] := smcBarra;
                  poiDiaFim[poiSlot] := smcDataConfirmada;
                  poiHoraFim[poiSlot] := smcHoraConfirmada;
                end;
              end;
        end;

        // Só disponibilizar os pivôs internos deste lote depois dos toques.
        if ModoRetesteFlip = 2 then
          for poiIndicePivo := 1 to 2 do
          begin
            poiDir := 1;
            if poiIndicePivo = 2 then
              poiDir := -1;
            if (not smcBarraValida) or ((smcFechamentoTicks - poiPivoNivel[poiIndicePivo]) * poiDir > 0) then
              poiPivoDisponivel[poiIndicePivo] := False;
            poiBarraPivo := smcPivoNaBarra[poiIndicePivo];
            if (poiBarraPivo >= 0) and smcPivoValido[poiIndicePivo]
              and (not flipPivoAmbiguo[0]) then
            begin
              poiPivoConfirmado[poiIndicePivo] := smcBarra;
              poiPivoNivel[poiIndicePivo] := Round(smcEventoLo[poiBarraPivo] / smcTick);
              poiPivoDisponivel[poiIndicePivo] := (smcFechamentoTicks - poiPivoNivel[poiIndicePivo]) * poiDir <= 0;
            end;
          end;
      end;

      // A 09B lê o Flip publicado neste lote. A origem nunca antecipa a ativação.
      if flipCalcula then
      begin
        poiATRBarra := smcATR;
        poiATRValido := smcATRDisponivel;
        for poiLado := 1 to 12 do
        begin
          poiLadoOriginal := Mod(poiLado - 1, 4) + 1;
          poiFamilia := 0;
          poiEvento := flipQualPublicado[poiLadoOriginal];
          if poiLado > 8 then
          begin
            poiFamilia := 2;
            poiEvento := flipContinuacaoSlot[poiLadoOriginal];
          end
          else if poiLado > 4 then
          begin
            poiFamilia := 1;
            if not MostrarExtremeFlip then
              poiEvento := -1;
          end;
          if poiEvento >= 0 then
          begin
            poiMotivoAtual := POIConfiguracaoInvalida;
            if poiCalcula then
            begin
              poiDir := 1;
              if Mod(poiLado, 2) = 0 then
                poiDir := -1;
              poiB := flipEventoConfirmacao[poiEvento];
              poiPerna := flipEventoOrigemReacao[poiEvento];
              if poiFamilia = 1 then
                poiPerna := flipEventoOrigemExtremo[poiEvento]
              else if poiFamilia = 2 then
              begin
                poiPerna := flipCorrecaoContinuacao[poiLadoOriginal];
                poiB := smcBarra;
              end;
              poiInicio := Max(poiPerna, poiB - MaxBuscaOrigemFlip);
              poiOrigem := -1;
              poiImpulso := poiB;
              poiSequencia := False;
              poiMotivoAtual := POISemOrigem;
              poiValido := (poiInicio >= 0) and (poiInicio < poiB)
                and (smcBarrasValidas >= smcBarra - poiInicio + 1);
              if poiValido then
              begin
                if (poiFamilia <> 2) and (FiltroDispFlip = 2) and (flipEventoDispInicio[poiEvento] >= poiInicio) then
                begin
                  poiImpulso := flipEventoDispInicio[poiEvento];
                  poiBusca := Min(poiB - 1, poiImpulso - 1);
                  poiTemImpulso := True;
                end
                else
                begin
                  // A primeira sequência encontrada de trás para frente
                  // termina ao encontrar um doji ou uma vela contrária.
                  poiBusca := poiB;
                  while (poiBusca >= poiInicio) and (not poiSequencia) do
                  begin
                    poiInc := CurrentBar - poiBusca;
                    poiSequencia := (Close[poiInc] - Open[poiInc]) * poiDir > 0;
                    poiBusca := poiBusca - 1;
                  end;
                  poiTemImpulso := poiSequencia;
                  if poiSequencia then
                  begin
                    poiImpulso := poiBusca + 1;
                    while (poiBusca >= poiInicio) and poiSequencia do
                    begin
                      poiInc := CurrentBar - poiBusca;
                      if (Close[poiInc] - Open[poiInc]) * poiDir > 0 then
                      begin
                        poiImpulso := poiBusca;
                        poiBusca := poiBusca - 1;
                      end
                      else
                        poiSequencia := False;
                    end;
                  end
                  else
                    poiBusca := poiB - 1;
                end;
                while (poiBusca >= poiInicio) and (poiOrigem < 0) do
                begin
                  poiInc := CurrentBar - poiBusca;
                  if (Close[poiInc] - Open[poiInc]) * poiDir < 0 then
                    poiOrigem := poiBusca;
                  poiBusca := poiBusca - 1;
                end;
                if (poiOrigem < 0) and FallbackPivoFlip and (poiPerna >= poiInicio) and (poiFamilia <> 1) then
                  poiOrigem := poiPerna;
                if poiFamilia = 1 then
                  if (poiOrigem <> poiPerna) or (poiImpulso <= poiOrigem) or (not poiTemImpulso) then
                  begin
                    poiOrigem := -1;
                    poiMotivoAtual := POISemOrigemCausal;
                  end;
              end
              else if (poiInicio >= 0) and (poiInicio < poiB) then
                poiMotivoAtual := POIDadosInvalidos;

              if poiOrigem >= 0 then
              begin
                poiInc := CurrentBar - poiOrigem;
                poiLo := Low[poiInc];
                poiHi := High[poiInc];
                if TipoZonaFlip = 1 then
                begin
                  if poiDir = 1 then
                    poiHi := Max(Open[poiInc], Close[poiInc])
                  else
                    poiLo := Min(Open[poiInc], Close[poiInc]);
                end
                else if (TipoZonaFlip = 2) and poiATRValido[poiInc - 1] then
                begin
                  poiATRBase := poiATRBarra[poiInc - 1];
                  poiBaseLo := poiLo;
                  poiBaseHi := poiHi;
                  poiCandles := 1;
                  poiBusca := poiOrigem - 1;
                  poiValido := True;
                  while (poiBusca >= poiPerna) and (poiBusca >= 0)
                    and (poiCandles < MaxBaseCandlesFlip) and poiValido do
                  begin
                    poiInc := CurrentBar - poiBusca;
                    poiMin := Low[poiInc];
                    poiMax := High[poiInc];
                    poiValido := (smcBarrasValidas >= poiInc) and (poiMax >= poiBaseLo)
                      and (poiMin <= poiBaseHi) and (poiMax - poiMin <= BaseRangeFlipATR * poiATRBase);
                    if poiValido then
                    begin
                      poiLo := Min(poiLo, poiMin);
                      poiHi := Max(poiHi, poiMax);
                      poiBaseLo := poiMin;
                      poiBaseHi := poiMax;
                      poiCandles := poiCandles + 1;
                      poiBusca := poiBusca - 1;
                    end;
                  end;
                end;
                poiLoTicks := Round(poiLo / smcTick);
                poiHiTicks := Round(poiHi / smcTick);
                if poiLoTicks - poiLo / smcTick > 0.00000001 then
                  poiLoTicks := poiLoTicks - 1;
                if poiHi / smcTick - poiHiTicks > 0.00000001 then
                  poiHiTicks := poiHiTicks + 1;
                poiMotivoAtual := POILarguraInvalida;
                poiInc := smcBarra - poiB;
                if (poiHiTicks > poiLoTicks) and ((MaxLarguraFlipATR = 0)
                  or (poiATRValido[poiInc] and ((poiHiTicks - poiLoTicks) * smcTick <= MaxLarguraFlipATR * poiATRBarra[poiInc]))) then
                begin
                  poiProx := poiHiTicks;
                  poiDist := poiLoTicks;
                  if poiDir = -1 then
                  begin
                    poiProx := poiLoTicks;
                    poiDist := poiHiTicks;
                  end;
                  poiSaiu := False;
                  poiPreMitigou := False;
                  poiVisitaInicial := False;
                  poiAproximaInicial := False;
                  poiInvalidou := False;
                  poiProf := 0;
                  for poiBusca := poiImpulso to smcBarra do
                  begin
                    poiInc := CurrentBar - poiBusca;
                    poiAvanco := Round(Close[poiInc] / smcTick) * poiDir;
                    poiInvalidou := poiInvalidou or (poiAvanco < poiDist * poiDir);
                    poiPavio := Round(Low[poiInc] / smcTick);
                    poiPavioReacao := Round(High[poiInc] / smcTick);
                    if poiDir = -1 then
                    begin
                      poiPavio := Round(High[poiInc] / smcTick);
                      poiPavioReacao := Round(Low[poiInc] / smcTick);
                    end;
                    poiDentro := (poiPavio * poiDir <= poiProx * poiDir)
                      and (poiPavioReacao * poiDir >= poiDist * poiDir);
                    if poiSaiu then
                    begin
                      poiVisitaInicial := poiDentro;
                      if poiDentro then
                      begin
                        poiPreMitigou := True;
                        poiProf := Max(poiProf, Min(1, (poiProx - poiPavio) * poiDir / (poiHiTicks - poiLoTicks)));
                      end
                      else
                        poiAproximaInicial := poiPavio * poiDir > poiProx * poiDir;
                    end
                    else if poiAvanco > poiProx * poiDir then
                    begin
                      poiSaiu := True;
                      poiAproximaInicial := True;
                    end;
                  end;
                  poiMotivoAtual := 0;
                  if poiInvalidou then
                    poiMotivoAtual := POIDistalAntesDaAtivacao
                  else if ExigirFreshFlip and poiPreMitigou then
                    poiMotivoAtual := POIPreMitigada;
                end;
              end;

              if (poiMotivoAtual = 0) and (FiltroFibFlip > 0) then
              begin
                flipQualLo := flipEventoFibLo[poiEvento];
                flipQualHi := flipEventoFibHi[poiEvento];
                flipQualFibOk := False;
                if flipQualHi > flipQualLo then
                begin
                  flipQualFaixaMin := 50;
                  flipQualFaixaMax := 100;
                  if FiltroFibFlip = 2 then
                    flipQualFaixaMin := FibPreferencialFlip
                  else if FiltroFibFlip = 3 then
                    flipQualFaixaMin := FibExtremoFlip
                  else if FiltroFibFlip = 4 then
                  begin
                    flipQualFaixaMin := FibCustomMin;
                    flipQualFaixaMax := FibCustomMax;
                  end;
                  if poiDir = -1 then
                  begin
                    flipQualCotaLo := (poiLoTicks * smcTick - flipQualLo) * 100 / (flipQualHi - flipQualLo);
                    flipQualCotaHi := (poiHiTicks * smcTick - flipQualLo) * 100 / (flipQualHi - flipQualLo);
                  end
                  else
                  begin
                    flipQualCotaLo := (flipQualHi - poiHiTicks * smcTick) * 100 / (flipQualHi - flipQualLo);
                    flipQualCotaHi := (flipQualHi - poiLoTicks * smcTick) * 100 / (flipQualHi - flipQualLo);
                  end;
                  flipQualCotaMedia := (flipQualCotaLo + flipQualCotaHi) / 2;
                  if ModoLocalizacaoFlip = 2 then
                    flipQualFibOk := (flipQualCotaHi >= flipQualFaixaMin) and (flipQualCotaLo <= flipQualFaixaMax)
                  else if ModoLocalizacaoFlip = 1 then
                    flipQualFibOk := (flipQualCotaLo >= flipQualFaixaMin) and (flipQualCotaHi <= flipQualFaixaMax)
                  else
                    flipQualFibOk := (flipQualCotaLo >= 0) and (flipQualCotaHi <= 100)
                      and (flipQualCotaMedia >= flipQualFaixaMin) and (flipQualCotaMedia <= flipQualFaixaMax);
                end;
                if not flipQualFibOk then
                  poiMotivoAtual := POIForaFib;
              end;

              if poiMotivoAtual = 0 then
              begin
                poiBase := (poiLado - 1) * FlipCapacidade;
                poiDestino := -1;
                poiTerminal := -1;
                if poiUsados[poiLado] > 0 then
                  for poiSlot := poiBase to poiBase + poiUsados[poiLado] - 1 do
                  begin
                    if (poiOrigemZona[poiSlot] = poiOrigem) and (poiLoZona[poiSlot] = poiLoTicks)
                      and (poiHiZona[poiSlot] = poiHiTicks) then
                      poiDestino := poiSlot;
                    if poiFimZona[poiSlot] >= 0 then
                    begin
                      if poiTerminal < 0 then
                        poiTerminal := poiSlot
                      else if (poiFimZona[poiSlot] < poiFimZona[poiTerminal])
                        or ((poiFimZona[poiSlot] = poiFimZona[poiTerminal]) and (poiID[poiSlot] < poiID[poiTerminal])) then
                        poiTerminal := poiSlot;
                    end;
                  end;
                if poiDestino < 0 then
                begin
                  poiDestino := poiTerminal;
                  if poiUsados[poiLado] < FlipCapacidade then
                  begin
                    poiDestino := poiBase + poiUsados[poiLado];
                    poiUsados[poiLado] := poiUsados[poiLado] + 1;
                  end;
                  if poiDestino < 0 then
                    poiMotivoAtual := SMCCapacityFull
                  else
                  begin
                    poiIdTotal := poiIdTotal + 1;
                    poiID[poiDestino] := poiIdTotal;
                    poiLados[poiDestino] := poiDir;
                    poiTipo[poiDestino] := poiFamilia;
                    poiLoZona[poiDestino] := poiLoTicks;
                    poiHiZona[poiDestino] := poiHiTicks;
                    poiOrigemZona[poiDestino] := poiOrigem;
                    poiInc := CurrentBar - poiOrigem;
                    poiDiaOrigem[poiDestino] := dataCandle[poiInc];
                    poiHoraOrigem[poiDestino] := horaCandle[poiInc];
                    poiAtivacao[poiDestino] := smcBarra;
                    poiPublicacao[poiDestino] := CurrentBar;
                    poiDia[poiDestino] := smcDataConfirmada;
                    poiHora[poiDestino] := smcHoraConfirmada;
                    poiFimZona[poiDestino] := -1;
                    poiToque[poiDestino] := -1;
                    poiVisitas[poiDestino] := 0;
                    poiReteste[poiDestino] := -1;
                    poiStatusReteste[poiDestino] := 0;
                    poiAlvoRef[poiDestino] := -1;
                    poiAlvoRompido[poiDestino] := False;
                    poiCruzouAlvo[poiDestino] := False;
                    poiIntersecaoInvalidacao[poiDestino] := False;
                    poiPrimeiraVisita[poiDestino] := False;
                    poiVisita[poiDestino] := poiVisitaInicial;
                    poiAproxima[poiDestino] := poiAproximaInicial;
                    poiPre[poiDestino] := poiPreMitigou;
                    poiProfundidade[poiDestino] := poiProf;
                    poiEstado[poiDestino] := POIAguardaSaida;
                    if poiSaiu then
                      poiEstado[poiDestino] := POIFresh;
                    if poiPreMitigou then
                    begin
                      poiEstado[poiDestino] := POITocada;
                      if poiProf >= 1 then
                        poiEstado[poiDestino] := POIMitigadaTotal
                      else if poiProf >= 0.5 then
                        poiEstado[poiDestino] := POIMitigada50;
                      if (EncerrarAposMitigacaoFlip > 0) and (poiProf * 100 >= EncerrarAposMitigacaoFlip) then
                      begin
                        poiEstado[poiDestino] := POIEncerrada;
                        poiFimZona[poiDestino] := smcBarra;
                        poiDiaFim[poiDestino] := smcDataConfirmada;
                        poiHoraFim[poiDestino] := smcHoraConfirmada;
                      end;
                    end;
                  end;
                end;
                if poiDestino >= 0 then
                begin
                  if poiFamilia = 0 then
                    flipEventoZonaID[poiEvento] := poiID[poiDestino]
                  else if poiFamilia = 1 then
                    flipEventoExtremeID[poiEvento] := poiID[poiDestino]
                  else
                    flipEventoContinuationID[poiEvento] := poiID[poiDestino];
                end;
              end;
            end;
            if poiFamilia = 0 then
              flipEventoZonaMotivo[poiEvento] := poiMotivoAtual
            else if poiFamilia = 1 then
              flipEventoExtremeMotivo[poiEvento] := poiMotivoAtual
            else
              flipEventoContinuationMotivo[poiEvento] := poiMotivoAtual;
          end;
        end;
      end;
      smcTemAnterior := smcBarraValida;
    end;
  end;

  // Seleção estável, com uma chamada por posição e por trecho de sessão.
  if idmCalcula and MostrarIDM and (ModoFaixaOB = 0) and LastBarOnChart
    and (CurrentBar > 0) and (smcOrigemPublicada = CurrentBar - 1) then
  begin
    idmVisiveis := 0;
    for idmLado := 1 to 2 do
      if ((idmLado = 1) and MostrarIDMLow) or ((idmLado = 2) and MostrarIDMHigh) then
      begin
        idmBase := (idmLado - 1) * IDMCapacidade;
        if idmUsados[idmLado] > 0 then
          for idmSlot := idmBase to idmBase + idmUsados[idmLado] - 1 do
          begin
            idmPosVisual := idmVisiveis;
            idmOrdenaAntes := True;
            while (idmPosVisual > 0) and idmOrdenaAntes do
            begin
              idmOutro := idmVisual[idmPosVisual];
              idmOrdenaAntes := (idmEstado[idmSlot] = IDMAtivo) and (idmEstado[idmOutro] <> IDMAtivo);
              if (idmEstado[idmSlot] = IDMAtivo) and (idmEstado[idmOutro] = IDMAtivo) then
                idmOrdenaAntes := (idmAtivacao[idmSlot] > idmAtivacao[idmOutro])
                  or ((idmAtivacao[idmSlot] = idmAtivacao[idmOutro]) and (idmID[idmSlot] > idmID[idmOutro]))
              else if (idmEstado[idmSlot] <> IDMAtivo) and (idmEstado[idmOutro] <> IDMAtivo) then
                idmOrdenaAntes := (idmFim[idmSlot] > idmFim[idmOutro])
                  or ((idmFim[idmSlot] = idmFim[idmOutro]) and (idmID[idmSlot] > idmID[idmOutro]));
              if idmOrdenaAntes then
              begin
                if idmPosVisual < IDMLimiteVisual then
                  idmVisual[idmPosVisual + 1] := idmOutro;
                idmPosVisual := idmPosVisual - 1;
              end;
            end;
            if idmPosVisual < IDMLimiteVisual then
            begin
              idmVisual[idmPosVisual + 1] := idmSlot;
              idmVisiveis := Min(idmVisiveis + 1, IDMLimiteVisual);
            end;
          end;
      end;

    if idmVisiveis > 0 then
      for idmPosVisual := 1 to idmVisiveis do
      begin
        idmSlot := idmVisual[idmPosVisual];
        idmPrecoDesenho := idmNivel[idmSlot];
        idmRotulo := "IDM LOW";
        idmCor := clGreen;
        if idmSlot >= IDMCapacidade then
        begin
          idmRotulo := "IDM HIGH";
          idmCor := clRed;
        end;
        idmDataDireita := dataCandle;
        idmHoraDireita := horaCandle;
        if idmEstado[idmSlot] <> IDMAtivo then
        begin
          idmDataDireita := idmDiaFim[idmSlot];
          idmHoraDireita := idmHoraFim[idmSlot];
        end;
        // Uma chamada fixa por posição, como nos desenhos existentes.
        if idmPosVisual = 1 then
          LineSegment(idmPrecoDesenho, idmPrecoDesenho, idmData[idmSlot], idmDataDireita, False, idmRotulo,
            idmCor, 1, 1, 8, 1, idmHora[idmSlot], idmHoraDireita)
        else if idmPosVisual = 2 then
          LineSegment(idmPrecoDesenho, idmPrecoDesenho, idmData[idmSlot], idmDataDireita, False, idmRotulo,
            idmCor, 1, 1, 8, 1, idmHora[idmSlot], idmHoraDireita)
        else if idmPosVisual = 3 then
          LineSegment(idmPrecoDesenho, idmPrecoDesenho, idmData[idmSlot], idmDataDireita, False, idmRotulo,
            idmCor, 1, 1, 8, 1, idmHora[idmSlot], idmHoraDireita)
        else if idmPosVisual = 4 then
          LineSegment(idmPrecoDesenho, idmPrecoDesenho, idmData[idmSlot], idmDataDireita, False, idmRotulo,
            idmCor, 1, 1, 8, 1, idmHora[idmSlot], idmHoraDireita)
        else if idmPosVisual = 5 then
          LineSegment(idmPrecoDesenho, idmPrecoDesenho, idmData[idmSlot], idmDataDireita, False, idmRotulo,
            idmCor, 1, 1, 8, 1, idmHora[idmSlot], idmHoraDireita)
        else if idmPosVisual = 6 then
          LineSegment(idmPrecoDesenho, idmPrecoDesenho, idmData[idmSlot], idmDataDireita, False, idmRotulo,
            idmCor, 1, 1, 8, 1, idmHora[idmSlot], idmHoraDireita)
        else if idmPosVisual = 7 then
          LineSegment(idmPrecoDesenho, idmPrecoDesenho, idmData[idmSlot], idmDataDireita, False, idmRotulo,
            idmCor, 1, 1, 8, 1, idmHora[idmSlot], idmHoraDireita)
        else if idmPosVisual = 8 then
          LineSegment(idmPrecoDesenho, idmPrecoDesenho, idmData[idmSlot], idmDataDireita, False, idmRotulo,
            idmCor, 1, 1, 8, 1, idmHora[idmSlot], idmHoraDireita)
        else if idmPosVisual = 9 then
          LineSegment(idmPrecoDesenho, idmPrecoDesenho, idmData[idmSlot], idmDataDireita, False, idmRotulo,
            idmCor, 1, 1, 8, 1, idmHora[idmSlot], idmHoraDireita)
        else if idmPosVisual = 10 then
          LineSegment(idmPrecoDesenho, idmPrecoDesenho, idmData[idmSlot], idmDataDireita, False, idmRotulo,
            idmCor, 1, 1, 8, 1, idmHora[idmSlot], idmHoraDireita);
      end;
  end;

  if poiCalcula and (MostrarFaixasFlip or MostrarExtremeFlip or MostrarContinuationFlip)
    and (ModoFaixaOB = 0) and LastBarOnChart
    and (CurrentBar > 0) and (smcOrigemPublicada = CurrentBar - 1) then
  begin
    poiTotalVisual := 0;
    for poiLado := 1 to 12 do
    begin
      poiBase := (poiLado - 1) * FlipCapacidade;
      if poiUsados[poiLado] > 0 then
        for poiSlot := poiBase to poiBase + poiUsados[poiLado] - 1 do
          if ((poiEstado[poiSlot] <> POIInvalidada) or (MostrarInvalidadasFlip > 0))
            and (((poiTipo[poiSlot] = 0) and MostrarFaixasFlip)
              or ((poiTipo[poiSlot] = 1) and MostrarExtremeFlip) or ((poiTipo[poiSlot] = 2) and MostrarContinuationFlip))
            and ((OcultarMitigadasFlip = 0) or (poiProfundidade[poiSlot] * 100 < OcultarMitigadasFlip)) then
          begin
            poiPos := poiTotalVisual;
            poiElegivel := True;
            while (poiPos > 0) and poiElegivel do
            begin
              poiTroca := poiOrdem[poiPos];
              poiElegivel := (poiAtivacao[poiSlot] > poiAtivacao[poiTroca])
                or ((poiAtivacao[poiSlot] = poiAtivacao[poiTroca]) and (poiOrigemZona[poiSlot] > poiOrigemZona[poiTroca]))
                or ((poiAtivacao[poiSlot] = poiAtivacao[poiTroca]) and (poiOrigemZona[poiSlot] = poiOrigemZona[poiTroca])
                  and (poiID[poiSlot] > poiID[poiTroca]));
              if poiElegivel then
              begin
                if poiPos < MaxFlipVisiveis then
                  poiOrdem[poiPos + 1] := poiTroca;
                poiPos := poiPos - 1;
              end;
            end;
            if poiPos < MaxFlipVisiveis then
            begin
              poiOrdem[poiPos + 1] := poiSlot;
              poiTotalVisual := Min(poiTotalVisual + 1, MaxFlipVisiveis);
            end;
          end;
    end;
    if poiTotalVisual > 0 then
      for poiPos := 1 to poiTotalVisual do
      begin
        poiSlot := poiOrdem[poiPos];
        poiCentroV[poiPos] := (poiHiZona[poiSlot] + poiLoZona[poiSlot]) * smcTick / 2;
        poiAlturaV[poiPos] := (poiHiZona[poiSlot] - poiLoZona[poiSlot]) * smcTick / 2;
        poiCores[poiPos] := CorFaixaFlipAlta;
        if poiLados[poiSlot] = -1 then
          poiCores[poiPos] := CorFaixaFlipBaixa;
        if (poiEstado[poiSlot] = POIInvalidada) and (MostrarInvalidadasFlip = 2) then
          poiCores[poiPos] := CorInvalidadaFlip;
        poiDiaIniV[poiPos] := poiDia[poiSlot];
        poiHoraIniV[poiPos] := poiHora[poiSlot];
        poiDiaOrigV[poiPos] := poiDiaOrigem[poiSlot];
        poiHoraOrigV[poiPos] := poiHoraOrigem[poiSlot];
        poiDataFim := smcDataConfirmada;
        poiHoraDesenhoFim := smcHoraConfirmada;
        if poiFimZona[poiSlot] >= 0 then
        begin
          poiDataFim := poiDiaFim[poiSlot];
          poiHoraDesenhoFim := poiHoraFim[poiSlot];
        end;
        poiDiaFimV[poiPos] := poiDataFim;
        poiHoraFimV[poiPos] := poiHoraDesenhoFim;
        poiDiaPrimeiroV[poiPos] := poiDataFim;
        poiHoraPrimeiroV[poiPos] := poiHoraDesenhoFim;
        poiMeioDiasV[poiPos] := False;
        if poiDiaIniV[poiPos] <> poiDataFim then
        begin
          poiDiaPrimeiroV[poiPos] := poiDiaIniV[poiPos];
          poiHoraPrimeiroV[poiPos] := 2359;
          poiMeioIniV[poiPos] := CalcDate(poiDiaIniV[poiPos], 1);
          poiMeioFimV[poiPos] := CalcDate(poiDataFim, -1);
          poiMeioDiasV[poiPos] := poiMeioIniV[poiPos] <= poiMeioFimV[poiPos];
        end;
      end;

    if poiTotalVisual >= 1 then
    begin
      poiRotulo := "POI FLIP+";
      if poiLados[poiOrdem[1]] = -1 then
        poiRotulo := "POI FLIP-";
      if poiTipo[poiOrdem[1]] = 1 then
        poiRotulo := "Extreme POI"
      else if poiTipo[poiOrdem[1]] = 2 then
        poiRotulo := "Continuation POI";
      HorizontalLineCustom(poiCentroV[1], poiCores[1], 1, 0, poiRotulo, 8, 1,
        poiDiaIniV[1], poiDiaPrimeiroV[1], poiAlturaV[1], poiHoraIniV[1], poiHoraPrimeiroV[1]);
      if poiMeioDiasV[1] then
        HorizontalLineCustom(poiCentroV[1], poiCores[1], 1, 0, "", 8, 1,
          poiMeioIniV[1], poiMeioFimV[1], poiAlturaV[1]);
      if poiDiaIniV[1] <> poiDiaFimV[1] then
        HorizontalLineCustom(poiCentroV[1], poiCores[1], 1, 0, "", 8, 1,
          poiDiaFimV[1], poiDiaFimV[1], poiAlturaV[1], 0, poiHoraFimV[1]);
      if MeioZonaFlip then
        HorizontalLineCustom(poiCentroV[1], poiCores[1], 1, 1, "", 8, 1,
          poiDiaIniV[1], poiDiaFimV[1], 0, poiHoraIniV[1], poiHoraFimV[1]);
      if MostrarOrigemFlip then
        LineSegment(poiCentroV[1], poiCentroV[1], poiDiaOrigV[1], poiDiaIniV[1], False, "Origem POI",
          poiCores[1], 1, 1, 8, 1, poiHoraOrigV[1], poiHoraIniV[1]);
    end;

    if poiTotalVisual >= 2 then
    begin
      poiRotulo := "POI FLIP+";
      if poiLados[poiOrdem[2]] = -1 then
        poiRotulo := "POI FLIP-";
      if poiTipo[poiOrdem[2]] = 1 then
        poiRotulo := "Extreme POI"
      else if poiTipo[poiOrdem[2]] = 2 then
        poiRotulo := "Continuation POI";
      HorizontalLineCustom(poiCentroV[2], poiCores[2], 1, 0, poiRotulo, 8, 1,
        poiDiaIniV[2], poiDiaPrimeiroV[2], poiAlturaV[2], poiHoraIniV[2], poiHoraPrimeiroV[2]);
      if poiMeioDiasV[2] then
        HorizontalLineCustom(poiCentroV[2], poiCores[2], 1, 0, "", 8, 1,
          poiMeioIniV[2], poiMeioFimV[2], poiAlturaV[2]);
      if poiDiaIniV[2] <> poiDiaFimV[2] then
        HorizontalLineCustom(poiCentroV[2], poiCores[2], 1, 0, "", 8, 1,
          poiDiaFimV[2], poiDiaFimV[2], poiAlturaV[2], 0, poiHoraFimV[2]);
      if MeioZonaFlip then
        HorizontalLineCustom(poiCentroV[2], poiCores[2], 1, 1, "", 8, 1,
          poiDiaIniV[2], poiDiaFimV[2], 0, poiHoraIniV[2], poiHoraFimV[2]);
      if MostrarOrigemFlip then
        LineSegment(poiCentroV[2], poiCentroV[2], poiDiaOrigV[2], poiDiaIniV[2], False, "Origem POI",
          poiCores[2], 1, 1, 8, 1, poiHoraOrigV[2], poiHoraIniV[2]);
    end;

    if poiTotalVisual >= 3 then
    begin
      poiRotulo := "POI FLIP+";
      if poiLados[poiOrdem[3]] = -1 then
        poiRotulo := "POI FLIP-";
      if poiTipo[poiOrdem[3]] = 1 then
        poiRotulo := "Extreme POI"
      else if poiTipo[poiOrdem[3]] = 2 then
        poiRotulo := "Continuation POI";
      HorizontalLineCustom(poiCentroV[3], poiCores[3], 1, 0, poiRotulo, 8, 1,
        poiDiaIniV[3], poiDiaPrimeiroV[3], poiAlturaV[3], poiHoraIniV[3], poiHoraPrimeiroV[3]);
      if poiMeioDiasV[3] then
        HorizontalLineCustom(poiCentroV[3], poiCores[3], 1, 0, "", 8, 1,
          poiMeioIniV[3], poiMeioFimV[3], poiAlturaV[3]);
      if poiDiaIniV[3] <> poiDiaFimV[3] then
        HorizontalLineCustom(poiCentroV[3], poiCores[3], 1, 0, "", 8, 1,
          poiDiaFimV[3], poiDiaFimV[3], poiAlturaV[3], 0, poiHoraFimV[3]);
      if MeioZonaFlip then
        HorizontalLineCustom(poiCentroV[3], poiCores[3], 1, 1, "", 8, 1,
          poiDiaIniV[3], poiDiaFimV[3], 0, poiHoraIniV[3], poiHoraFimV[3]);
      if MostrarOrigemFlip then
        LineSegment(poiCentroV[3], poiCentroV[3], poiDiaOrigV[3], poiDiaIniV[3], False, "Origem POI",
          poiCores[3], 1, 1, 8, 1, poiHoraOrigV[3], poiHoraIniV[3]);
    end;

    if poiTotalVisual >= 4 then
    begin
      poiRotulo := "POI FLIP+";
      if poiLados[poiOrdem[4]] = -1 then
        poiRotulo := "POI FLIP-";
      if poiTipo[poiOrdem[4]] = 1 then
        poiRotulo := "Extreme POI"
      else if poiTipo[poiOrdem[4]] = 2 then
        poiRotulo := "Continuation POI";
      HorizontalLineCustom(poiCentroV[4], poiCores[4], 1, 0, poiRotulo, 8, 1,
        poiDiaIniV[4], poiDiaPrimeiroV[4], poiAlturaV[4], poiHoraIniV[4], poiHoraPrimeiroV[4]);
      if poiMeioDiasV[4] then
        HorizontalLineCustom(poiCentroV[4], poiCores[4], 1, 0, "", 8, 1,
          poiMeioIniV[4], poiMeioFimV[4], poiAlturaV[4]);
      if poiDiaIniV[4] <> poiDiaFimV[4] then
        HorizontalLineCustom(poiCentroV[4], poiCores[4], 1, 0, "", 8, 1,
          poiDiaFimV[4], poiDiaFimV[4], poiAlturaV[4], 0, poiHoraFimV[4]);
      if MeioZonaFlip then
        HorizontalLineCustom(poiCentroV[4], poiCores[4], 1, 1, "", 8, 1,
          poiDiaIniV[4], poiDiaFimV[4], 0, poiHoraIniV[4], poiHoraFimV[4]);
      if MostrarOrigemFlip then
        LineSegment(poiCentroV[4], poiCentroV[4], poiDiaOrigV[4], poiDiaIniV[4], False, "Origem POI",
          poiCores[4], 1, 1, 8, 1, poiHoraOrigV[4], poiHoraIniV[4]);
    end;

    if poiTotalVisual >= 5 then
    begin
      poiRotulo := "POI FLIP+";
      if poiLados[poiOrdem[5]] = -1 then
        poiRotulo := "POI FLIP-";
      if poiTipo[poiOrdem[5]] = 1 then
        poiRotulo := "Extreme POI"
